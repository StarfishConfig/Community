{
    "Euonia": {
        "Bus": {
            "DefaultTransport": "in-memory",
            "InMemory": {
                "Name": "in-memory",
                "MultipleSubscriberInstance": false,
                "IsDefaultTransport": true
            },
            "RabbitMq": {
                "Enabled": false,
                "Name": "rabbit-mq",
                "Connection": "amqp://guest:guest@localhost",
                "SubscriptionId": "starfish-server"
            }
        },
        "Uow": {
            "IsTransactional": true
        }
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*"
}
