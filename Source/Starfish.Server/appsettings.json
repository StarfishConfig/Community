{
    "ConnectionStrings": {
        "Identity": ""
    },
    "Authentication": {
        "Scheme": "Cookies",
        "UsePolicy": false,
        "Bearer": {
            "RequireHttpsMetadata": false,
            "Authority": "https://configserver.io",
            "Audience": null,
            "Issuer": [
                "configserver.io"
            ],
            "ValidateIssuer": true,
            "ValidateAudience": false,
            "SigningKey": "GImXbOaM2RNkzHhJ7/q3NpYMa1j/xqlahPg9KwX99qI=",
            "RoleClaimType": "http://schemas.microsoft.com/ws/2008/06/identity/claims/role"
        },
        "Cookie": {
            "LoginPath": "/identity/login",
            "LogoutPath": "/identity/logout",
            "AccessDeniedPath": "/access-denied",
            "SlidingExpiration": true
        }
    },
    "Euonia": {
        "Bus": {
            "DefaultTransport": "InMemory",
            "InMemory": {
                "Name": "InMemory",
                "MultipleSubscriberInstance": false,
                "IsDefaultTransport": true
            },
            "RabbitMq": {
                "Enabled": false,
                "Name": "RabbitMq",
                "Connection": "amqp://guest:guest@localhost",
                "SubscriptionId": "starfish-server"
            }
        },
        "Uow": {
            "IsTransactional": true
        },
        "Caching": {
            "DefaultCache": "Memory",
            "Priority": [
                "Redis",
                "Memory",
                "Runtime"
            ],
            "Memory": {
                "KeyPrefix": "Starfish",
                "IsDefaultCache": true
            },
            "Redis": {
                "KeyPrefix": "Starfish",
                "Database": 0,
                "ConnectionString": "localhost:6379"
            },
            "Runtime": {
                "KeyPrefix": "Starfish"
            }
        }
    },
    "ExternalAuth": {
        "RedirectUri": "https://configserver.io/auth/callback",
        "Github": {
            "ClientId": "your-github-client-id",
            "ClientSecret": "your-github-client-secret"
        },
        "Google": {
            "ClientId": "your-google-client-id",
            "ClientSecret": "your-google-client-secret"
        },
        "Facebook": {
            "ClientId": "your-facebook-app-id",
            "ClientSecret": "your-facebook-app-secret"
        },
        "Microsoft": {
            "ClientId": "your-microsoft-app-id",
            "ClientSecret": "your-microsoft-app-secret"
        }
    },
    "CorsOrigins": [
        "https://localhost",
        "https://localhost:7030",
        "https://configserver.io"
    ],
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*"
}
