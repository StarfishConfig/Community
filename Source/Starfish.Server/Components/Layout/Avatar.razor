@using System.Security.Claims
@inject NavigationManager Navigation

<FluentProfileMenu Initials="BG"
                   @ref="_instance"
                   Image="https://s.gravatar.com/avatar/38a519cc759f85fc814868d0656c0c18?s=480">
    <StartTemplate>
        <span style="color: white">@Title</span>
    </StartTemplate>
    <HeaderTemplate>
        <FluentLabel Typo="@Typography.Header">@Identity.Username</FluentLabel>
    </HeaderTemplate>
    <ChildContent>
        <div style="width: 250px; height: 80px">
            <FluentLabel>@Email</FluentLabel>
            <FluentLabel>@Phone</FluentLabel>
        </div>
    </ChildContent>
    <FooterTemplate>
        <FluentStack>
            <FluentButton Appearance="Appearance.Lightweight" OnClick="@OnProfileClicked">Profile</FluentButton>
            <FluentSpacer/>
            <FluentButton Appearance="@Appearance.Outline" OnClick="@OnLogoutClicked">Logout</FluentButton>
        </FluentStack>
    </FooterTemplate>
</FluentProfileMenu>

@code {

    private FluentProfileMenu _instance;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; }

    private UserPrincipal Identity { get; set; }

    private string Title => string.Collapse(Identity?.FindClaim("nickname")?.Value, Identity?.Username, "Starfish");

    private string Email => Identity?.FindClaim(ClaimTypes.Email)?.Value;

    private string Phone => Identity?.FindClaim(ClaimTypes.MobilePhone)?.Value;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationState;
        Identity = new UserPrincipal(state.User);
        StateHasChanged();
    }

    private async Task OnProfileClicked(MouseEventArgs args)
    {
        _instance?.Open = false;

        Navigation.NavigateTo("/profile");
        await Task.CompletedTask;
    }

    private async Task OnLogoutClicked(MouseEventArgs args)
    {
        Navigation.NavigateTo("/logout", true);
        await Task.CompletedTask;
    }

}