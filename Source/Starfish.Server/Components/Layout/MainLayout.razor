@inherits LayoutComponentBase

@inject NavigationManager NavigationManager

<FluentDesignTheme StorageName="theme" OfficeColor="OfficeColor.Office"/>
<FluentLayout>
    <FluentHeader Class="site-header">
        <a href="/" aria-label="Back to the homepage" style="text-decoration: none">
            <div class="logo" role="presentation" aria-hidden="true" itemprop="logo" itemscope="itemscope">
                <img src="logo.svg" alt="starfish"/>
                <span>@CommonResources.IDS_COMMON_TITLE</span>
            </div>
        </a>
        <FluentSpacer/>

        @* <div class="search"> *@
        @*     <DemoSearch/> *@
        @* </div> *@

        @* <div class="links"> *@
        @*     <FluentAnchor Appearance="Appearance.Hypertext" *@
        @*                   Href="https://github.com/microsoft/fluentui-blazor" Target="_blank" Rel="noreferrer noopener" *@
        @*                   title="Fluent UI Blazor library source on GitHub" *@
        @*                   aria-label="Fluent UI Blazor library source on GitHub"> *@
        @*         <FluentIcon Value="@(new Icons.Filled.Size20.GitHub())" Color="Color.FillInverse"/> *@
        @*     </FluentAnchor> *@
        @* </div> *@
        <div style="display: flex; align-items: center; gap: 8px;">
            <NotificationCenter/>
            <SiteSettings/>
            <Avatar @rendermode="InteractiveServer"/>
        </div>

    </FluentHeader>

    <FluentStack Class="body-stack" Orientation="Orientation.Horizontal" Width="100%" HorizontalGap="0">

        <CascadingValue Value="Identity">
            <MainMenuPanel/>
        </CascadingValue>

        <FluentBodyContent id="body-content" Style="height: calc(100dvh - 90px);">
            <div class="content">
                <article id="article">
                    <CascadingValue Value="@OnRefreshTableOfContents">
                        @Body
                    </CascadingValue>

                </article>

                <FluentMessageBarProvider Section="TOP" ClearAfterNavigation="true" @rendermode="InteractiveServer"/>
                <FluentToastProvider MaxToastCount="10" @rendermode="InteractiveServer"/>
                <FluentDialogProvider @rendermode="InteractiveServer"/>
                <FluentTooltipProvider @rendermode="InteractiveServer"/>
                <FluentKeyCodeProvider @rendermode="InteractiveServer"/>
                <FluentMenuProvider @rendermode="InteractiveServer"/>
            </div>
        </FluentBodyContent>
    </FluentStack>

    <FluentFooter Class="main-layout-footer">
        <div class="version">
            <a href="/term">Term</a>
            <span>|</span>
            <a target="_blank" href="https://github.com/StarfishConfig/Community/blob/main/LICENSE">License</a>
            <span>|</span>
            <a target="_blank" href="https://github.com/NerosoftDev/Euonia">Powered by Euonia</a>
        </div>
        <FluentSpacer/>
        <div class="copy">
            © 2025 Nerosoft, All rights reserved.
        </div>
    </FluentFooter>
</FluentLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

