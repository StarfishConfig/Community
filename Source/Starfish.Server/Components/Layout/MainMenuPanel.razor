@using System.Collections.ObjectModel
@using Nerosoft.Starfish.Shared
<div class="navmenu">
    <input type="checkbox" title="Menu expand/collapse toggle" id="navmenu-toggle" class="navmenu-icon"/>
    <label for="navmenu-toggle" class="navmenu-icon">
        <FluentIcon Value="@(new Icons.Regular.Size20.Navigation())" Color="Color.Neutral"/>
    </label>
    <nav class="sitenav" aria-labelledby="main-menu">
        <FluentNavMenu Id="main-menu" Title="Main menu" CustomToggle="true">
            @foreach (var item in Items)
            {
                <MainMenuItem Value="item"/>
            }
        </FluentNavMenu>
    </nav>

</div>

@code {

    [CascadingParameter]
    private UserPrincipal Identity { get; set; }

    private ObservableCollection<MenuItem> Items { get; } = [];

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        Items.Add(new MenuLink("/", new Icons.Regular.Size20.Home(), LayoutResources.IDS_MENU_TEXT_HOME, NavLinkMatch.All));
        Items.Add(new MenuLink("/configs", new Icons.Regular.Size20.Apps(), LayoutResources.IDS_MENU_TEXT_CONFIGURATION_MANAGEMENT, NavLinkMatch.All));
        Items.Add(new MenuLink("/clients", new Icons.Regular.Size20.Desktop(), LayoutResources.IDS_MENU_TEXT_CLIENT_MANAGEMENT));
        Items.Add(new MenuLink("/nodes", new Icons.Regular.Size20.ServerMultiple(), LayoutResources.IDS_MENU_TEXT_NODES_MANAGEMENT));
        Items.Add(new MenuLink("/teams", new Icons.Regular.Size20.PeopleTeam(), LayoutResources.IDS_MENU_TEXT_TEAM_MANAGEMENT));
        if (Identity.IsInRoles(RoleName.Admin))
        {
            Items.Add(new MenuLink("/users", new Icons.Regular.Size20.PeopleList(), LayoutResources.IDS_MENU_TEXT_USER_MANAGEMENT));
            Items.Add(new MenuLink("/preferences", new Icons.Regular.Size20.PreviewLink(), LayoutResources.IDS_MENU_TEXT_PREFERENCES));
            Items.Add(new MenuLink("/settings", new Icons.Regular.Size20.Settings(), LayoutResources.IDS_MENU_TEXT_SYSTEM_SETTINGS));
            Items.Add(new MenuLink("/templates", new Icons.Regular.Size20.DocumentChevronDouble(), LayoutResources.IDS_MENU_TEXT_TEMPLATE));
            Items.Add(new MenuLink("/logging", new Icons.Regular.Size20.DocumentText(), LayoutResources.IDS_MENU_TEXT_OPERATION_LOGS));
        }

        // Items.Add(new MenuGroup(new Icons.Regular.Size20.PeopleCommunication(), LayoutResources.IDS_MENU_TEXT_USER_MANAGEMENT, false, "10px", new List<MenuItem>
        // {
        //     new MenuLink("/account/users/", null, LayoutResources.IDS_MENU_TEXT_USER_LIST),
        //     new MenuLink("/account/roles", null, LayoutResources.IDS_MENU_TEXT_ROLE_MANAGEMENT)
        // }));
        // Items.Add(new MenuGroup(new Icons.Regular.Size20.Settings(), LayoutResources.IDS_MENU_TEXT_SYSTEM_MANAGEMENT, false, "10px", new List<MenuItem>
        // {
        //     new MenuLink("/system/settings", null, LayoutResources.IDS_MENU_TEXT_SYSTEM_SETTINGS),
        //     new MenuLink("/system/preferences", null, LayoutResources.IDS_MENU_TEXT_PREFERENCES),
        //     new MenuLink("/system/template", null, LayoutResources.IDS_MENU_TEXT_TEMPLATE)
        // }));
        await base.OnInitializedAsync();
    }

}