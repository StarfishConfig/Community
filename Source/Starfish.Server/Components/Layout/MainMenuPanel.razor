@using System.Collections.ObjectModel
<div class="navmenu">
    <input type="checkbox" title="Menu expand/collapse toggle" id="navmenu-toggle" class="navmenu-icon" />
    <label for="navmenu-toggle" class="navmenu-icon">
        <FluentIcon Value="@(new Icons.Regular.Size20.Navigation())" Color="Color.Neutral" />
    </label>
    <nav class="sitenav" aria-labelledby="main-menu">
        <FluentNavMenu Id="main-menu" Title="Main menu" CustomToggle="true">
            @foreach (var item in Items)
            {
                <MainMenuItem Value="item" />
            }
        </FluentNavMenu>
    </nav>

</div>

@code {
    private ObservableCollection<MenuItem> Items { get; } = [];

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        Items.Add(new MenuLink("/", new Icons.Regular.Size20.Home(), LayoutResources.IDS_MENU_TEXT_HOME, NavLinkMatch.All));
        Items.Add(new MenuLink("/team", new Icons.Regular.Size20.ChartMultiple(), LayoutResources.IDS_MENU_TEXT_TEAM_MANAGEMENT));
        Items.Add(new MenuGroup(new Icons.Regular.Size20.Folder(), LayoutResources.IDS_MENU_TEXT_USER_MANAGEMENT, false, "10px", new List<MenuItem>
        {
            new MenuLink("/users/", null, LayoutResources.IDS_MENU_TEXT_USER_LIST),
            new MenuLink("/roles", null, LayoutResources.IDS_MENU_TEXT_ROLE_MANAGEMENT),
            new MenuLink("/permissions", null, LayoutResources.IDS_MENU_TEXT_PERMISSION_MANAGEMENT)
        }));
        Items.Add(new MenuGroup(new Icons.Regular.Size20.Settings(), LayoutResources.IDS_MENU_TEXT_SETTINGS, false, "10px", new List<MenuItem>
        {
            new MenuLink("/system/settings", null, LayoutResources.IDS_MENU_TEXT_SYSTEM_SETTINGS),
            new MenuLink("/system/preferences", null, LayoutResources.IDS_MENU_TEXT_PREFERENCES),
            new MenuLink("/system/template", null, LayoutResources.IDS_MENU_TEXT_TEMPLATE)
        }));
        await base.OnInitializedAsync();
    }

}