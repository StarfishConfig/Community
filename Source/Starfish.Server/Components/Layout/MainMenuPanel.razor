@using System.Collections.ObjectModel
@using NavLink = Nerosoft.Starfish.Server.Components.Shared.MenuLink
<div class="navmenu">
    <input type="checkbox" title="Menu expand/collapse toggle" id="navmenu-toggle" class="navmenu-icon"/>
    <label for="navmenu-toggle" class="navmenu-icon">
        <FluentIcon Value="@(new Icons.Regular.Size20.Navigation())" Color="Color.Neutral"/>
    </label>
    <nav class="sitenav" aria-labelledby="main-menu">
        <FluentNavMenu Id="main-menu" Title="Main menu" CustomToggle="true">
            @foreach (var item in Items)
            {
                <MainMenuItem Value="item"/>
            }
        </FluentNavMenu>
    </nav>

</div>

@code {
    private ObservableCollection<MenuItem> Items { get; } = [];

    protected override async Task OnInitializedAsync()
    {
        Items.Add(new NavLink("/", new Icons.Regular.Size20.Home(), "首页", NavLinkMatch.All));
        Items.Add(new NavLink("/team", new Icons.Regular.Size20.ChartMultiple(), "分组"));
        Items.Add(new MenuGroup(new Icons.Regular.Size20.Folder(), "用户", true, "10px", new List<MenuItem>
        {
            new NavLink("/users/list", null, "用户列表"),
            new NavLink("/users/roles", null, "角色管理"),
            new NavLink("/users/permissions", null, "权限管理")
        }));
        Items.Add(new MenuGroup(new Icons.Regular.Size20.Settings(), "设置", false, "10px", new List<MenuItem>
        {
            new NavLink("/settings/profile", null, "个人资料"),
            new NavLink("/settings/preferences", null, "偏好设置")
        }));
        await base.OnInitializedAsync();
    }

}