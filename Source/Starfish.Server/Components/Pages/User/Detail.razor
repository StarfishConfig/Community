@page "/users/{Id}"

@attribute [Authorize(Roles = RoleName.Admin)]

@inject IUserApplicationService UserService
@inject IAuthlogApplicationService AuthlogService
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageTitle>@UserResources.IDS_PAGE_DETAIL_TITLE</PageTitle>

<FluentStack VerticalGap="16" Orientation="Orientation.Vertical" Style="width: 100%">
    <FluentBreadcrumb Style="margin-bottom: 16px;">
        <FluentBreadcrumbItem Href="/">@LayoutResources.IDS_MENU_TEXT_HOME</FluentBreadcrumbItem>
        <FluentBreadcrumbItem Href="/users">@LayoutResources.IDS_MENU_TEXT_USER_MANAGEMENT</FluentBreadcrumbItem>
        <FluentBreadcrumbItem Href="@($"/users/{Id}")">@UserResources.IDS_PAGE_DETAIL_TITLE</FluentBreadcrumbItem>
    </FluentBreadcrumb>

    <FluentLabel Typo="Typography.Header">@UserResources.IDS_PAGE_DETAIL_TITLE</FluentLabel>

    <FluentCard>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
            <FluentAccordion Style="width: 100%">
                <FluentAccordionItem Heading="@UserResources.IDS_PAGE_DETAIL_PANEL_HEADER_INFO" Expanded="true">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Info())" Color="@Color.Neutral" Slot="start" />
                    <FluentGrid Spacing="2" Justify="JustifyContent.FlexStart" Style="padding: 5px;">
                        <FluentGridItem md="6" sm="12">
                            <FluentTextField Value="@Data?.Username"
                                             Label="@UserResources.IDS_PAGE_DETAIL_LABEL_USERNAME"
                                             Style="width: 100%" Disabled="true"
                                             Class="input-disabled" />
                        </FluentGridItem>

                        <FluentGridItem md="6" sm="12">
                            <FluentTextField Value="@Data?.Nickname"
                                             Label="@UserResources.IDS_PAGE_DETAIL_LABEL_NICKNAME"
                                             Style="width: 100%" Disabled="true"
                                             Class="input-disabled" />
                        </FluentGridItem>

                        <FluentGridItem md="6" sm="12">
                            <FluentTextField Value="@Data?.Email" Label="@UserResources.IDS_PAGE_DETAIL_LABEL_EMAIL"
                                             Style="width: 100%" Disabled="true"
                                             Class="input-disabled" />
                        </FluentGridItem>

                        <FluentGridItem md="6" sm="12">
                            <FluentTextField Value="@Data?.Phone" Label="@UserResources.IDS_PAGE_DETAIL_LABEL_PHONE"
                                             Style="width: 100%" Disabled="true"
                                             Class="input-disabled" />
                        </FluentGridItem>

                        <FluentGridItem md="6" sm="12">
                            <FluentTextField Value="@Data?.AccessFailedCount.ToString()"
                                             Label="@UserResources.IDS_PAGE_DETAIL_LABEL_FAILED_COUNT"
                                             Style="width: 100%;" Disabled="true"
                                             Class="input-disabled" />
                        </FluentGridItem>
                        <FluentGridItem md="6" sm="12">
                            <FluentTextField Value="@Data?.LockoutEnd.ToString()"
                                             Label="@UserResources.IDS_PAGE_DETAIL_LABEL_LOCKOUT_END"
                                             Style="width: 100%;" Disabled="true"
                                             Class="input-disabled" />
                        </FluentGridItem>

                        <FluentGridItem md="6" sm="12">
                            <FluentTextField Value="@Data?.CreatedAt.ToShortDateString()"
                                             Label="@UserResources.IDS_PAGE_DETAIL_LABEL_CREATE_TIME"
                                             Style="width: 100%;" Disabled="true"
                                             Class="input-disabled" />
                        </FluentGridItem>
                        <FluentGridItem md="6" sm="12">
                            <FluentTextField Value="@Data?.UpdatedAt.ToShortDateString()"
                                             Label="@UserResources.IDS_PAGE_DETAIL_LABEL_UPDATE_TIME"
                                             Style="width: 100%;" Disabled="true"
                                             Class="input-disabled" />
                        </FluentGridItem>

                        <FluentGridItem md="6" sm="12">
                            <FluentTextField Value="@Data?.LastLoginAt.ToString()"
                                             Label="@UserResources.IDS_PAGE_DETAIL_LABEL_LAST_LOGIN_TIME"
                                             Style="width: 100%;" Disabled="true"
                                             Class="input-disabled" />
                        </FluentGridItem>
                        <FluentGridItem md="6" sm="12">
                            <FluentTextField Value="@Data?.LastLoginIp"
                                             Label="@UserResources.IDS_PAGE_DETAIL_LABEL_LAST_LOGIN_IP"
                                             Style="width: 100%;" Disabled="true"
                                             Class="input-disabled" />
                        </FluentGridItem>

                        @if (Data != null)
                        {
                            <FluentGridItem md="12">
                                <FluentStack Orientation="Orientation.Horizontal"
                                             HorizontalAlignment="HorizontalAlignment.End">

                                    <FluentButton IconStart="@(new Icons.Regular.Size16.Add())"
                                                  Appearance="Appearance.Lightweight"
                                                  OnClick="@OnResetPasswordClicked">
                                        @UserResources.IDS_PAGE_DETAIL_BUTTON_TEXT_RESET_PASSWORD
                                    </FluentButton>

                                    <FluentButton IconStart="@(new Icons.Regular.Size16.Edit())"
                                                  Appearance="Appearance.Stealth"
                                                  Loading="@Loading"
                                                  OnClick="@OnEditClicked">

                                        @CommonResources.IDS_BUTTON_TEXT_EDIT
                                    </FluentButton>

                                </FluentStack>
                            </FluentGridItem>
                        }

                    </FluentGrid>

                </FluentAccordionItem>

                <FluentAccordionItem Heading="@UserResources.IDS_PAGE_DETAIL_PANEL_HEADER_AUTHLOG" Expanded="true">
                    <FluentIcon Value="@(new Icons.Regular.Size20.DocumentBulletList())" Color="@Color.Neutral" Slot="start" />

                    @if (Data != null)
                    {
                        <Authlog Username="@Data.Username" />
                    }

                </FluentAccordionItem>
            </FluentAccordion>

        </FluentStack>
    </FluentCard>
</FluentStack>

@code {

    [Parameter]
    public string Id { get; set; }

    [CascadingParameter]
    private UserPrincipal Identity { get; set; }

    private UserDetailDto Data { get; set; }

    private bool Loading { get; set; }



    protected override async Task OnInitializedAsync()
    {
        Data = await UserService.GetAsync(Id);
        if (Data == null)
        {
            Navigation.NavigateTo("/not-found");
        }
        else
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnResetPasswordClicked(MouseEventArgs args)
    {
        var message = string.Format(UserResources.IDS_MESSAGE_RESTPWD_COMFIRMATION, Data.Username);

        var dialog = await DialogService.ShowConfirmationAsync(message, CommonResources.IDS_COMMON_YES, CommonResources.IDS_COMMON_NO, CommonResources.IDS_DIALOG_TITLE_CONFIRM);

        var result = await dialog.Result;

        if (!result.Cancelled)
        {
            var password = await UserService.ResetPasswordAsync(Id);
            await DialogService.ShowSuccessAsync(string.Format(UserResources.IDS_MESSAGE_RESTPWD_SUCCEED, password), CommonResources.IDS_DIALOG_TITLE_NOTICE);
        }
    }

    private async Task OnEditClicked(MouseEventArgs args)
    {
        DialogParameters parameters = new()
        {
            Title = UserResources.IDS_PAGE_EDIT_TITLE_UPDATE,
            Modal = true,
            ShowDismiss = false,
            PreventDismissOnOverlayClick = true
        };

        var dialog = await DialogService.ShowDialogAsync<Update>(Id, parameters);

        var result = await dialog.Result;
        if (!result.Cancelled)
        {

        }
    }


}