@page "/users"

@inject IUserApplicationService Service
@inject IDialogService DialogService

<PageTitle>@UserResources.IDS_PAGE_INDEX_TITLE</PageTitle>

<FluentStack VerticalGap="16" Orientation="Orientation.Vertical" Style="width: 100%">
    <FluentBreadcrumb Style="margin-bottom: 16px;">
        <FluentBreadcrumbItem Href="/">@LayoutResources.IDS_MENU_TEXT_HOME</FluentBreadcrumbItem>
        <FluentBreadcrumbItem Href="/users">@LayoutResources.IDS_MENU_TEXT_USER_MANAGEMENT</FluentBreadcrumbItem>
    </FluentBreadcrumb>

    <FluentLabel Typo="Typography.Header">@UserResources.IDS_PAGE_INDEX_TITLE</FluentLabel>
    <FluentCard>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
            <FluentAccordion Style="width: 100%">
                <FluentAccordionItem Heading="@CommonResources.IDS_LABEL_TEXT_FILTER" Expanded="true">
                    <FluentIcon Value="@(new Icons.Regular.Size20.FilterAdd())" Color="@Color.Neutral" Slot="start"/>
                    <FluentGrid Spacing="1" Justify="JustifyContent.FlexStart" Style="padding: 5px;">
                        <FluentGridItem xs="12" sm="6" md="3">
                            <FluentTextField @bind-Value="Keyword" Label="@CommonResources.IDS_LABEL_TEXT_KEYWORD"
                                             Style="width: 100%"
                                             Placeholder="@CommonResources.IDS_PLACEHOLDER_KEYWORD"/>
                        </FluentGridItem>
                        <FluentGridItem xs="12" sm="6" md="3">
                            <FluentSelect TOption="Option<bool?>"
                                          Items="@LockOptions"
                                          OptionValue="@(i => i.Value.ToString())"
                                          OptionText="@(i => i.Text)"
                                          Label="@UserResources.IDS_PAGE_INDEX_COLUMN_LOCKOUT"
                                          Style="width: 100%"
                                          @bind-SelectedOption="@SelectedLockOption"/>
                        </FluentGridItem>
                    </FluentGrid>
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.End">
                        <FluentButton IconStart="@(new Icons.Regular.Size16.Add())"
                                      Appearance="Appearance.Lightweight"
                                      OnClick="@(() => OnEditClicked(string.Empty))">
                            @UserResources.IDS_PAGE_INDEX_BUTTON_TEXT_CREATE
                        </FluentButton>
                        <FluentButton IconStart="@(new Icons.Regular.Size16.Broom())"
                                      Disabled="@Loading"
                                      OnClick="@OnClearClicked">
                            @CommonResources.IDS_BUTTON_TEXT_CLEAR_FILTER
                        </FluentButton>
                        <FluentButton IconStart="@(new Icons.Regular.Size16.Search())"
                                      Appearance="Appearance.Accent"
                                      Loading="@Loading"
                                      OnClick="@OnSearchClicked">
                            @CommonResources.IDS_BUTTON_TEXT_SEARCH
                        </FluentButton>
                    </FluentStack>
                </FluentAccordionItem>
            </FluentAccordion>

            <FluentDataGrid @ref="_dataGrid" Style="width: 100%"
                            TGridItem="UserListDto"
                            Items="_dataSource"
                            RowSize="DataGridRowSize.Large"
                            GenerateHeader="GenerateHeaderOption.Sticky"
                            Loading="Loading"
                            Pagination="Pagination"
                            RefreshItems="@RefreshItemsAsync">
                <TemplateColumn Title="@UserResources.IDS_PAGE_INDEX_COLUMN_USERNAME">
                    <FluentAnchor Appearance="Appearance.Hypertext"
                                  Href="@($"/users/{context.Id}")">@context.Username</FluentAnchor>
                </TemplateColumn>
                <PropertyColumn Title="@UserResources.IDS_PAGE_INDEX_COLUMN_NICKNAME"
                                Property="@(p => p.Nickname)"/>
                <PropertyColumn Title="@UserResources.IDS_PAGE_INDEX_COLUMN_EMAIL"
                                Property="@(p => p.Email)"/>
                <PropertyColumn Title="@UserResources.IDS_PAGE_INDEX_COLUMN_PHONE"
                                Property="@(p => p.Phone)"/>
                <PropertyColumn Title="@CommonResources.IDS_COMMON_COLUMN_CREATE_TIME"
                                Property="@(p => p.LockoutEnd)"/>
                <PropertyColumn Title="@CommonResources.IDS_COMMON_COLUMN_UPDATE_TIME"
                                Property="@(p => p.CreatedAt)"/>
                <TemplateColumn Title="@CommonResources.IDS_COMMON_COLUMN_ACTIONS" Align="@Align.Center">
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Center">
                        <FluentButton
                            OnClick="@(() => OnEditClicked(context.Id))">@CommonResources.IDS_BUTTON_TEXT_EDIT</FluentButton>
                        @* <FluentButton OnClick="@(() => OnResetPasswordClicked(context.Id, context.Username))" *@
                        @*               Appearance="Appearance.Lightweight">@IdentityResources.IDS_USER_INDEX_BUTTON_TEXT_RESETPWD</FluentButton> *@
                    </FluentStack>
                </TemplateColumn>
            </FluentDataGrid>

            <FluentDataGridPaginator State="@Pagination"/>
        </FluentStack>
    </FluentCard>
</FluentStack>

@code {
    private bool Loading { get; set; }

    private string Keyword { get; set; } = string.Empty;

    private FluentDataGrid<UserListDto> _dataGrid;
    private IQueryable<UserListDto> _dataSource = Enumerable.Empty<UserListDto>().AsQueryable();
    private PaginationState Pagination { get; } = new() { ItemsPerPage = 10 };

    private List<Option<bool?>> LockOptions { get; } =
    [
        new() { Value = null, Text = CommonResources.IDS_COMMON_ALL, Selected = true },
        new() { Value = true, Text = CommonResources.IDS_COMMON_YES },
        new() { Value = false, Text = CommonResources.IDS_COMMON_NO }
    ];

    private Option<bool?> SelectedLockOption { get; set; }

    private async Task OnSearchClicked(MouseEventArgs args)
    {
        await _dataGrid.RefreshDataAsync(true);
    }

    private async Task OnClearClicked(MouseEventArgs args)
    {
        Keyword = string.Empty;
        await _dataGrid.RefreshDataAsync(true);
    }

    private async Task OnEditClicked(string id)
    {
        DialogParameters parameters = new()
        {
            Title = string.IsNullOrWhiteSpace(id) ? UserResources.IDS_PAGE_EDIT_TITLE_CREATE : UserResources.IDS_PAGE_EDIT_TITLE_UPDATE,
            Modal = true,
            ShowDismiss = false,
            PreventDismissOnOverlayClick = true
        };

        IDialogReference dialog;
        if (!string.IsNullOrWhiteSpace(id))
        {
            dialog = await DialogService.ShowDialogAsync<Update>(id, parameters);
        }
        else
        {
            dialog = await DialogService.ShowDialogAsync<Create>(parameters);
        }

        var result = await dialog.Result;
        if (!result.Cancelled)
        {
            await Pagination.SetCurrentPageIndexAsync(0);
        }
    }

    private async Task RefreshItemsAsync(GridItemsProviderRequest<UserListDto> request)
    {
        Loading = true;

        await InvokeAsync(StateHasChanged);

        var result = await Service.SearchAsync(Keyword, SelectedLockOption?.Value, 0, Pagination.ItemsPerPage);

        _dataSource = result.AsQueryable();

        Loading = false;

        await InvokeAsync(StateHasChanged);
    }
}
