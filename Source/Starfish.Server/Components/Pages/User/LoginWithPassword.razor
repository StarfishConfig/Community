@using System.Security.Claims
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.AspNetCore.Identity
@using Nerosoft.Euonia.Caching
@using Nerosoft.Starfish.Shared

@inject IAuthApplicationService AuthService
@inject IToastService ToastService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject ICacheService CacheService

<FluentEditForm OnSubmit="@OnSubmitAsync" EditContext="_editContext" FormName="form">
    <DataAnnotationsValidator />
    <FluentValidationSummary />

    <FluentGrid Columns="12" RowGap="10" ColumnGap="10">
        <FluentGridItem md="12">
            <FluentTextField Name="Model.Username" @bind-Value="Model.Username"
                             AutoComplete="off" Required="true"
                             Placeholder="Username/Email/Phone"
                             Style="width: 100%"
                             Immediate="true" ImmediateDelay="0">
                <FluentIcon Value="@(new Icons.Regular.Size24.Person())" Slot="start"
                            Color="Color.Neutral" />
            </FluentTextField>
        </FluentGridItem>
        <FluentGridItem md="12">
            <FluentTextField Name="Model.Password" @bind-Value="Model.Password"
                             AutoComplete="off" Required="true" Placeholder="Password to login"
                             Style="width: 100%"
                             TextFieldType="TextFieldType.Password"
                             Immediate="true" ImmediateDelay="0">
                <FluentIcon Value="@(new Icons.Regular.Size24.ShieldKeyhole())" Slot="start"
                            Color="Color.Neutral" />
            </FluentTextField>
        </FluentGridItem>

        <FluentGridItem md="12">
            <div style="width: 100%; display: flex;align-items: center;">
                <FluentButton Style="width: 100px;" Loading="Loading" Appearance="Appearance.Accent"
                              Type="ButtonType.Submit">@UserResources.IDS_PAGE_LOGIN_BUTTON_TEXT_SUBMIT</FluentButton>
                <FluentSpacer />
                <a href="/password/reset">@UserResources.IDS_PAGE_LOGIN_BUTTON_TEXT_FORGET_PASSWORD</a>
            </div>
        </FluentGridItem>
    </FluentGrid>

</FluentEditForm>

@code {
    [Parameter]
    public EventCallback<ClaimsPrincipal> OnSuccess { get; set; }

    [CascadingParameter]
    public HttpContext HttpContext { get; set; }

    [Parameter]
    public string ReturnUrl { get; set; } = "/";

    private LoginModel Model { get; } = new();

    private EditContext _editContext;

    private bool Loading { get; set; } = false;

    /// <summary>
    /// Initializes the component.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(Model);
        await base.OnInitializedAsync();
    }

    private async Task OnSubmitAsync(EditContext context)
    {
        try
        {
            if (!context.Validate())
            {
                return;
            }

            Loading = true;

            var dto = new TokenGrantRequestDto
            {
                Username = Model.Username,
                Password = Model.Password,
                GrantType = AuthProvider.Username
            };

            // if (HttpContext == null)
            // {
            //     var result = await Service.GrantAsync(dto);
            //     await LocalStorage.SetAsync(IdentityConstants.BearerScheme, result);
            //     Navigation.NavigateTo(ReturnUrl);
            // }
            // else
            // {
            //     var result = await Service.SignInAsync(dto);
            //     await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, result);
            //     HttpContext.Response.Redirect(ReturnUrl);
            // }

            //await Service.SignInAsync(dto, ReturnUrl);
            // await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, result);
            // HttpContext.Response.Redirect(ReturnUrl);

            // using (var client = new HttpClient())
            // {
            //     client.BaseAddress = new Uri("https://starfish.dev.localhost:7141/");
            //     var response = await client.PostAsJsonAsync("/api/auth/signin", dto);
            //     var cookie = await response.Content.ReadAsStringAsync();
            //     await JSRuntime.InvokeVoidAsync("cookies.set", cookie);
            //     //Navigation.NavigateTo(ReturnUrl, true);
            // }

            // var response = await JSRuntime.InvokeAsync<string>("apiCall.post", "/api/auth/signin", dto);
            // if (!string.IsNullOrEmpty(response))
            // {
            //     throw new Exception(response);
            // }
            // Navigation.NavigateTo(ReturnUrl, true);

            var result = await AuthService.SignInAsync(dto);

            var ticket = Guid.NewGuid().ToString();

            await CacheService.AddOrUpdateAsync(ticket, () => Task.FromResult(result), TimeSpan.FromMinutes(1));

            Navigation.NavigateTo($"/login?ticket={ticket}&returnUrl={Uri.EscapeDataString(ReturnUrl)}", true);
        }
        catch (Exception exception)
        {
            ToastService.ShowError(exception.GetErrorMessage());
        }
        finally
        {
            Loading = false;
        }
    }

    private class LoginModel
    {
        [Required]
        public string Username { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;
    }
}
