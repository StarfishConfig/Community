@page "/password/reset"
@using global::System.ComponentModel.DataAnnotations
@layout EmptyLayout

@inject IUserApplicationService Service
@inject NavigationManager Navigation

<PageTitle>@UserResources.IDS_PAGE_RESET_PASSWORD_TITLE</PageTitle>

<div class="main" style="width: 468px; margin: 50px auto auto;">
    <FluentStack Orientation="Orientation.Vertical">
        <div style="text-align:center;margin:32px auto;box-shadow:none;line-height: 36px;">
            <div class="header" style="display: flex; align-items: center;gap: 10px;">
                <img alt="logo" class="logo" src="logo.svg">
                <span class="title" style="color:#fcab66; font-size: 24px;">Starfish</span>
            </div>
            <div class="desc">@(CommonResources.IDS_COMMON_SUBTITLE)</div>
        </div>
        <FluentCard>
            <FluentEditForm FormName="form" EditContext="_editContext" OnSubmit="@OnSubmitAsync">
                <DataAnnotationsValidator/>
                <FluentValidationSummary/>
                <FluentTabs Size="TabSize.Large">
                    <FluentTab Label="@UserResources.IDS_PAGE_RESET_PASSWORD_TITLE"
                               Id="Tab-ResetPassword" Style="padding:16px 0">
                        <FluentGrid Columns="12" RowGap="10" ColumnGap="10">
                            <FluentGridItem md="12">
                                <FluentTextField Name="Model.Email" @bind-Value="Model.Email"
                                                 AutoComplete="off" Required="true"
                                                 Placeholder="@UserResources.IDS_PAGE_RESET_PASSWORD_PLACEHOLDER_EMAIL"
                                                 Style="width: 100%">
                                    <FluentIcon Value="@(new Icons.Regular.Size24.Person())" Slot="start"
                                                Color="Color.Neutral"/>
                                </FluentTextField>
                            </FluentGridItem>
                            <FluentGridItem md="9">
                                <FluentTextField Name="Model.Token" @bind-Value="Model.Token"
                                                 AutoComplete="off" Required="true"
                                                 Placeholder="@UserResources.IDS_PAGE_RESET_PASSWORD_PLACEHOLDER_VERIFY_CODE"
                                                 Maxlength="6" Minlength="6"
                                                 InputMode="InputMode.Numeric"
                                                 Style="width: 100%">
                                    <FluentIcon Value="@(new Icons.Regular.Size24.PhoneKey())"
                                                Slot="start"
                                                Color="Color.Neutral"/>
                                </FluentTextField>
                            </FluentGridItem>
                            <FluentGridItem md="3">
                                <CountDownButton DefaultText="@UserResources.IDS_PAGE_RESET_PASSWORD_BUTTON_TEXT_SEND_OTP"
                                                 CountingText="@UserResources.IDS_PAGE_RESET_PASSWORD_BUTTON_TEXT_COUNTING"
                                                 CountdownSeconds="60" Action="@OnSendOtpAsync"
                                                 Style="width: 100%"/>
                            </FluentGridItem>
                            <FluentGridItem md="12">
                                <FluentTextField Name="Model.Password" @bind-Value="Model.Password"
                                                 AutoComplete="off"
                                                 Required="true"
                                                 Placeholder="@UserResources.IDS_RESET_PASSWORD_PLACEHOLDER_PASSWORD"
                                                 Style="width: 100%"
                                                 TextFieldType="TextFieldType.Password">
                                    <FluentIcon Value="@(new Icons.Regular.Size24.ShieldKeyhole())" Slot="start"
                                                Color="Color.Neutral"/>
                                </FluentTextField>
                            </FluentGridItem>
                            <FluentGridItem md="12">
                                <div style="width: 100%; display: flex;align-items: center;">
                                    <FluentButton Style="width: 100px;" Loading="Loading" Appearance="Appearance.Accent"
                                                  Type="ButtonType.Submit">@CommonResources.IDS_BUTTON_TEXT_SUBMIT</FluentButton>
                                    <FluentSpacer/>
                                    <a href="/login">@UserResources.IDS_PAGE_RESET_PASSWORD_BUTTON_TEXT_BACK_LOGIN</a>
                                </div>
                            </FluentGridItem>
                        </FluentGrid>
                    </FluentTab>
                </FluentTabs>
            </FluentEditForm>
        </FluentCard>
    </FluentStack>
</div>

@code {

    [CascadingParameter]
    private HttpContext HttpContext { get; set; }

    [SupplyParameterFromForm]
    private ResetPasswordModel Model { get; set; }

    private bool Loading { get; set; } = false;
    private EditContext _editContext;

    protected override async Task OnInitializedAsync()
    {
        Model ??= new ResetPasswordModel();
        _editContext = new EditContext(Model);
        await base.OnInitializedAsync();
    }

    private async Task OnSubmitAsync(EditContext context)
    {
        var dto = new UserPasswordResetDto
        {
            Username = Model.Email,
            Password = Model.Password,
            Token = Model.Token
        };

        await Service.ResetPasswordAsync(dto);
        Navigation.NavigateTo("/login");
    }

    private async Task<bool> OnSendOtpAsync()
    {
        try
        {
            if (string.IsNullOrEmpty(Model.Email))
            {
                throw new ValidationException(UserResources.IDS_ERROR_USERNAME_REQUIRED);
            }

            return true;
        }
        catch (Exception ex)
        {
            return false;
        }
    }

    private class ResetPasswordModel
    {
        public string Email { get; set; }

        public string Password { get; set; }

        public string Token { get; set; }
    }

}