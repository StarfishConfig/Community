@implements IDialogContentComponent

@using System.ComponentModel.DataAnnotations

@inject IUserApplicationService Service

<FluentDialogHeader ShowDismiss="true">
    <FluentStack VerticalAlignment="VerticalAlignment.Center">
        <FluentIcon Value="@(new Icons.Regular.Size24.PeopleTeam())"/>
        <FluentLabel Typo="Typography.PaneHeader">
            @Dialog.Instance.Parameters.Title
        </FluentLabel>
    </FluentStack>
</FluentDialogHeader>

<FluentDialogBody>
    <FluentStack Orientation="Orientation.Vertical">
        <FluentEditForm @ref="_editForm" EditContext="_editContext" OnSubmit="@OnSubmitAsync" FormName="form"
                        Style="width: 100%">
            <DataAnnotationsValidator/>

            <FluentStack Orientation="Orientation.Vertical">
                <FluentTextField Label="@UserResources.IDS_PAGE_EDIT_LABEL_USERNAME"
                                 Placeholder="@UserResources.IDS_PAGE_EDIT_PLACEHOLDER_USERNAME"
                                 Style="width: 100%"
                                 @bind-Value="Model.Username"
                                 TextFieldType="TextFieldType.Text"/>

                <FluentTextField Label="@UserResources.IDS_PAGE_EDIT_LABEL_PASSWORD"
                                 Placeholder="@UserResources.IDS_PAGE_EDIT_PLACEHOLDER_PASSWORD"
                                 Style="width: 100%"
                                 @bind-Value="Model.Password"
                                 TextFieldType="TextFieldType.Password"/>

                <FluentTextField Label="@UserResources.IDS_PAGE_EDIT_LABEL_NICKNAME"
                                 Placeholder="@UserResources.IDS_PAGE_EDIT_PLACEHOLDER_NICKNAME"
                                 Style="width: 100%"
                                 @bind-Value="Model.Nickname"/>

                <FluentTextField Label="@UserResources.IDS_PAGE_EDIT_LABEL_EMAIL"
                                 Placeholder="@UserResources.IDS_PAGE_EDIT_PLACEHOLDER_EMAIL"
                                 Style="width: 100%"
                                 @bind-Value="Model.Email"
                                 TextFieldType="TextFieldType.Email"/>

                <FluentTextField Label="@UserResources.IDS_PAGE_EDIT_LABEL_PHONE"
                                 Placeholder="@UserResources.IDS_PAGE_EDIT_PLACEHOLDER_PHONE"
                                 Style="width: 100%"
                                 @bind-Value="Model.Phone"
                                 TextFieldType="TextFieldType.Tel"/>
            </FluentStack>

            <FluentValidationSummary/>
        </FluentEditForm>
    </FluentStack>
</FluentDialogBody>

<FluentDialogFooter>
    <FluentButton Appearance="Appearance.Accent" OnClick="@SaveAsync"
                  Loading="Loading">@(CommonResources.IDS_COMMON_SAVE)</FluentButton>
    <FluentButton Appearance="Appearance.Neutral"
                  OnClick="@(() => Dialog.CancelAsync())">@(CommonResources.IDS_COMMON_CANCEL)</FluentButton>
</FluentDialogFooter>

@code {

    [CascadingParameter]
    public FluentDialog Dialog { get; set; }

    private bool Loading { get; set; }

    private EditContext _editContext;
    private FluentEditForm _editForm;

    private ViewModel Model { get; } = new();

    /// <inheritdoc/>
    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(Model);
        await base.OnInitializedAsync();
    }

    private async Task SaveAsync(MouseEventArgs args)
    {
        await _editForm.OnSubmit.InvokeAsync(_editContext);
    }

    private async Task OnSubmitAsync(EditContext context)
    {
        if (!context.Validate())
        {
            return;
        }

        Loading = true;
        var data = new UserCreateDto
        {
            Username = Model.Username,
            Email = Model.Email,
            Nickname = Model.Nickname,
            Password = Model.Password,
            Phone = Model.Phone
        };
        await Service.CreateAsync(data);
        Loading = false;
        
        await Dialog.CloseAsync();
    }

    private class ViewModel
    {
        [Required(AllowEmptyStrings = false, ErrorMessageResourceType = typeof(UserResources),
            ErrorMessageResourceName = nameof(UserResources.IDS_ERROR_USERNAME_REQUIRED))]
        [StringLength(255, MinimumLength = 4, ErrorMessageResourceType = typeof(UserResources),
            ErrorMessageResourceName = nameof(UserResources.IDS_ERROR_USERNAME_STRING_LENGTH))]
        public string Username { get; set; }

        [StringLength(64, MinimumLength = 2, ErrorMessageResourceType = typeof(UserResources),
            ErrorMessageResourceName = nameof(UserResources.IDS_ERROR_NICKNAME_LENGTH))]
        public string Nickname { get; set; }

        [Required(AllowEmptyStrings = false, ErrorMessageResourceType = typeof(UserResources),
            ErrorMessageResourceName = nameof(UserResources.IDS_ERROR_EMAIL_REQUIRED))]
        [RegularExpression(RegexPattern.EmailAddress, ErrorMessageResourceType = typeof(UserResources),
            ErrorMessageResourceName = nameof(UserResources.IDS_ERROR_EMAIL_FORMAT_INCORRECT))]
        public string Email { get; set; }

        [RegularExpression(RegexPattern.PhoneNumber, ErrorMessageResourceType = typeof(UserResources),
            ErrorMessageResourceName = nameof(UserResources.IDS_ERROR_PHONE_FORMAT))]
        public string Phone { get; set; }

        [Required(AllowEmptyStrings = false, ErrorMessageResourceType = typeof(UserResources),
            ErrorMessageResourceName = nameof(UserResources.IDS_ERROR_PASSWORD_REQUIRED))]
        [StringLength(32, MinimumLength = 6, ErrorMessageResourceType = typeof(UserResources),
            ErrorMessageResourceName = nameof(UserResources.IDS_ERROR_PASSWORD_STRING_LENGTH))]
        public string Password { get; set; }
    }

}