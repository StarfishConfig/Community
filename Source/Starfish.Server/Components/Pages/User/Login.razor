@page "/login"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Nerosoft.Euonia.Caching
@layout EmptyLayout

@attribute [ExcludeFromInteractiveRouting]
@attribute [AllowAnonymous]


<PageTitle>@UserResources.IDS_PAGE_LOGIN_TITLE</PageTitle>

<div class="main" style="width: 468px; margin: 50px auto auto;">

    <FluentStack Orientation="Orientation.Vertical">
        <div style="text-align:center;margin:32px auto;box-shadow:none;line-height: 36px;">
            <div class="header" style="display: flex; align-items: center;gap: 10px;">
                <img alt="logo" class="logo" src="logo.svg">
                <span class="title" style="color:#fcab66; font-size: 24px;">Starfish</span>
            </div>
            <div class="desc">@(CommonResources.IDS_COMMON_SUBTITLE)</div>
        </div>
        <CascadingValue Value="@HttpContext">
            <FluentCard>
                @if (string.IsNullOrEmpty(Ticket))
                {
                    <FluentTabs Size="TabSize.Large">
                        <FluentTab Label="Login via Password" Id="Tab-Password" Style="padding:16px 0">
                            <LoginWithPassword ReturnUrl="@ReturnUrl"
                                               @rendermode="InteractiveServer" />
                        </FluentTab>
                        <FluentTab Label="Login via OTP" Id="Tab-OTP" Style="padding: 16px 0"
                                   Disabled="true">
                            <LoginWithOnetimeCode />
                        </FluentTab>
                    </FluentTabs>
                }
                else
                {
                    <LoginWithTicket Ticket="@Ticket" ReturnUrl="@ReturnUrl" />
                }
            </FluentCard>
        </CascadingValue>
    </FluentStack>
</div>

@code {

    [CascadingParameter]
    private HttpContext HttpContext { get; set; }

    [SupplyParameterFromQuery]
    public string Ticket { get; set; }

    [SupplyParameterFromQuery]
    private string ReturnUrl { get; set; } // => HttpContext?.Request.Query["returnUrl"] ?? "/";

    private async Task OnSuccessAsync(ClaimsPrincipal principal)
    {
        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, principal);
        HttpContext.Response.Redirect(ReturnUrl);
    }
}