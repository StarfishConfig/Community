@page "/users/{Id}/edit"
@page "/users/new"
@using System.ComponentModel.DataAnnotations

@inject IUserApplicationService Service
@inject NavigationManager NavigationManager

<FluentStack VerticalGap="16" Orientation="Orientation.Vertical">
    @if (!string.IsNullOrWhiteSpace(Id))
    {
        <FluentBreadcrumb Style="margin-bottom: 16px;">
            <FluentBreadcrumbItem Href="/">@LayoutResources.IDS_MENU_TEXT_HOME</FluentBreadcrumbItem>
            <FluentBreadcrumbItem Href="/users">@LayoutResources.IDS_MENU_TEXT_USER_MANAGEMENT</FluentBreadcrumbItem>
            <FluentBreadcrumbItem
                Href="@($"/users/{Id}/edit")">@IdentityResources.IDS_USER_EDIT_TITLE_UPDATE</FluentBreadcrumbItem>
        </FluentBreadcrumb>
        <FluentLabel Typo="Typography.Header">@IdentityResources.IDS_USER_EDIT_TITLE_UPDATE</FluentLabel>
    }
    else
    {
        <FluentBreadcrumb Style="margin-bottom: 16px;">
            <FluentBreadcrumbItem Href="/">@LayoutResources.IDS_MENU_TEXT_HOME</FluentBreadcrumbItem>
            <FluentBreadcrumbItem Href="/users">@LayoutResources.IDS_MENU_TEXT_USER_MANAGEMENT</FluentBreadcrumbItem>
            <FluentBreadcrumbItem
                Href="/users/new">@IdentityResources.IDS_USER_EDIT_TITLE_CREATE</FluentBreadcrumbItem>
        </FluentBreadcrumb>
        <FluentLabel Typo="Typography.Header">@IdentityResources.IDS_USER_EDIT_TITLE_CREATE</FluentLabel>
    }

    <FluentEditForm EditContext="_editContext" OnSubmit="@OnSubmitAsync" FormName="form" Style="width: 100%">
        <DataAnnotationsValidator/>
        <FluentValidationSummary/>

        <FluentBodyContent>
            <FluentGrid Columns="12" RowGap="10" ColumnGap="10">
                <FluentGridItem md="6" lg="4" sm="12">
                    <FluentTextField Label="@IdentityResources.IDS_USER_EDIT_LABEL_USERNAME"
                                     Placeholder="@IdentityResources.IDS_USER_EDIT_PLACEHOLDER_USERNAME"
                                     Style="width: 100%"
                                     @bind-Value="Model.Username" TextFieldType="TextFieldType.Text"/>

                </FluentGridItem>
                <FluentGridItem md="6" lg="8" HiddenWhen="GridItemHidden.SmAndDown"></FluentGridItem>
                <FluentGridItem md="6" lg="4" sm="12">
                    <FluentTextField Label="@IdentityResources.IDS_USER_EDIT_LABEL_NICKNAME"
                                     Placeholder="@IdentityResources.IDS_USER_EDIT_PLACEHOLDER_NICKNAME"
                                     Style="width: 100%"
                                     @bind-Value="Model.Nickname" TextFieldType="TextFieldType.Text"/>

                </FluentGridItem>
                <FluentGridItem md="6" lg="8" HiddenWhen="GridItemHidden.SmAndDown"></FluentGridItem>
                @if (string.IsNullOrWhiteSpace(Id))
                {
                    <FluentGridItem md="6" lg="4" sm="12">
                        <FluentTextField Label="@IdentityResources.IDS_USER_EDIT_LABEL_PASSWORD"
                                         Placeholder="@IdentityResources.IDS_USER_EDIT_PLACEHOLDER_PASSWORD"
                                         Style="width: 100%"
                                         @bind-Value="Model.Password"
                                         TextFieldType="TextFieldType.Password"/>

                    </FluentGridItem>
                    <FluentGridItem md="6" lg="8" HiddenWhen="GridItemHidden.SmAndDown"></FluentGridItem>
                }
                <FluentGridItem md="6" lg="4" sm="12">
                    <FluentTextField Label="@IdentityResources.IDS_USER_EDIT_LABEL_EMAIL"
                                     Placeholder="@IdentityResources.IDS_USER_EDIT_PLACEHOLDER_EMAIL"
                                     Style="width: 100%"
                                     @bind-Value="Model.Email" TextFieldType="TextFieldType.Email"/>

                </FluentGridItem>
                <FluentGridItem md="6" lg="8" HiddenWhen="GridItemHidden.SmAndDown"></FluentGridItem>
                <FluentGridItem md="6" lg="4" sm="12">
                    <FluentTextField Label="@IdentityResources.IDS_USER_EDIT_LABEL_PHONE"
                                     Placeholder="@IdentityResources.IDS_USER_EDIT_PLACEHOLDER_PHONE"
                                     Style="width: 100%"
                                     @bind-Value="Model.Phone" TextFieldType="TextFieldType.Tel"/>

                </FluentGridItem>
                <FluentGridItem md="6" lg="8" HiddenWhen="GridItemHidden.SmAndDown"></FluentGridItem>
            </FluentGrid>
        </FluentBodyContent>
    </FluentEditForm>
</FluentStack>

@code {

    /// <summary>
    /// The user identifier.
    /// </summary>
    [Parameter]
    public string Id { get; set; }

    private EditContext _editContext;

    private UserEditModel Model { get; } = new();

    /// <inheritdoc/>
    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(Model);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!string.IsNullOrWhiteSpace(Id) && Id != "new")
        {
            // Load existing user data
            var user = await Service.GetAsync(Id);
            Model.Username = user.Username;
            Model.Email = user.Email;
            Model.Phone = user.Phone;
            Model.Nickname = user.Nickname;
        }
    }

    private async Task OnSubmitAsync(EditContext context)
    {
        if (string.IsNullOrWhiteSpace(Id))
        {
            var data = new UserCreateDto
            {
                Username = Model.Username,
                Email = Model.Email,
                Nickname = Model.Nickname,
                Password = Model.Password,
                Phone = Model.Phone
            };
            await Service.CreateAsync(data);
        }
        else
        {
            var data = new UserUpdateDto
            {
                Email = Model.Email,
                Nickname = Model.Nickname,
                Phone = Model.Phone
            };

            await Service.UpdateAsync(Id, data);
        }

        NavigationManager.NavigateTo("/users");
    }

    private class UserEditModel
    {
        public string Username { get; set; }
        public string Nickname { get; set; }

        [EmailAddress]
        public string Email { get; set; }

        [Phone]
        public string Phone { get; set; }

        public string Password { get; set; }
    }

}