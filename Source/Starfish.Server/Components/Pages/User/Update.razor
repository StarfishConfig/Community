@page "/users/{Id}/edit"
@using System.ComponentModel.DataAnnotations
@using Nerosoft.Starfish.Shared

@inject IUserApplicationService Service
@inject NavigationManager NavigationManager

<FluentStack VerticalGap="16" Orientation="Orientation.Vertical">
    <FluentBreadcrumb Style="margin-bottom: 16px;">
        <FluentBreadcrumbItem Href="/">@LayoutResources.IDS_MENU_TEXT_HOME</FluentBreadcrumbItem>
        <FluentBreadcrumbItem Href="/users">@LayoutResources.IDS_MENU_TEXT_USER_MANAGEMENT</FluentBreadcrumbItem>
        <FluentBreadcrumbItem Href="@($"/users/{Id}/edit")">@IdentityResources.IDS_USER_EDIT_TITLE_UPDATE</FluentBreadcrumbItem>
    </FluentBreadcrumb>
    <FluentLabel Typo="Typography.Header">@IdentityResources.IDS_USER_EDIT_TITLE_UPDATE</FluentLabel>

    <FluentCard>
        <FluentEditForm EditContext="_editContext" OnSubmit="@OnSubmitAsync" FormName="form" Style="width: 100%">
            <DataAnnotationsValidator />

            <FluentGrid Columns="12" RowGap="10" ColumnGap="10">

                <FluentGridItem sm="4" md="3" lg="3" Class="input-group-label">
                    <FluentLabel Alignment="HorizontalAlignment.Right">@IdentityResources.IDS_USER_EDIT_LABEL_USERNAME</FluentLabel>
                </FluentGridItem>
                <FluentGridItem sm="8" md="6" lg="6">
                    <FluentTextField Placeholder="@IdentityResources.IDS_USER_EDIT_PLACEHOLDER_USERNAME"
                                     Style="width: 100%"
                                     ReadOnly="true"
                                     Value="@Model.Username" TextFieldType="TextFieldType.Text" />
                </FluentGridItem>
                <FluentGridItem md="3" lg="3" HiddenWhen="GridItemHidden.SmAndDown" />

                <FluentGridItem sm="4" md="3" lg="3" Class="input-group-label">
                    <FluentLabel Alignment="HorizontalAlignment.Right">@IdentityResources.IDS_USER_EDIT_LABEL_NICKNAME</FluentLabel>
                </FluentGridItem>
                <FluentGridItem sm="8" md="6" lg="6">
                    <FluentTextField Placeholder="@IdentityResources.IDS_USER_EDIT_PLACEHOLDER_NICKNAME"
                                     Style="width: 100%"
                                     @bind-Value="Model.Nickname" TextFieldType="TextFieldType.Text" />

                </FluentGridItem>
                <FluentGridItem md="3" lg="3" HiddenWhen="GridItemHidden.SmAndDown" />

                <FluentGridItem sm="4" md="3" lg="3" Class="input-group-label">
                    <FluentLabel Alignment="HorizontalAlignment.Right">@IdentityResources.IDS_USER_EDIT_LABEL_EMAIL</FluentLabel>
                </FluentGridItem>
                <FluentGridItem md="8" lg="6" sm="6">
                    <FluentTextField Placeholder="@IdentityResources.IDS_USER_EDIT_PLACEHOLDER_EMAIL"
                                     Style="width: 100%"
                                     @bind-Value="Model.Email" TextFieldType="TextFieldType.Email" />

                </FluentGridItem>
                <FluentGridItem md="3" lg="3" HiddenWhen="GridItemHidden.SmAndDown" />

                <FluentGridItem sm="4" md="3" lg="3" Class="input-group-label">
                    <FluentLabel Alignment="HorizontalAlignment.Right">@IdentityResources.IDS_USER_EDIT_LABEL_PHONE</FluentLabel>
                </FluentGridItem>
                <FluentGridItem md="8" lg="6" sm="6">
                    <FluentTextField Placeholder="@IdentityResources.IDS_USER_EDIT_PLACEHOLDER_PHONE"
                                     Style="width: 100%"
                                     @bind-Value="Model.Phone" TextFieldType="TextFieldType.Tel" />

                </FluentGridItem>
                <FluentGridItem md="3" lg="3" HiddenWhen="GridItemHidden.SmAndDown" />

                <FluentGridItem sm="4" md="3" lg="3" />
                <FluentGridItem md="8" lg="6" sm="6">
                    <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent">@CommonResources.IDS_BUTTON_TEXT_SUBMIT</FluentButton>
                </FluentGridItem>
                <FluentGridItem md="3" lg="3" HiddenWhen="GridItemHidden.SmAndDown" />

                <FluentGridItem sm="4" md="3" lg="3" />
                <FluentGridItem>
                    <FluentValidationSummary />
                </FluentGridItem>
            </FluentGrid>

        </FluentEditForm>
    </FluentCard>
</FluentStack>

@code {

    /// <summary>
    /// The user identifier.
    /// </summary>
    [Parameter]
    public string Id { get; set; }

    private EditContext _editContext;

    private ViewModel Model { get; } = new();

    /// <inheritdoc/>
    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(Model);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!string.IsNullOrWhiteSpace(Id))
        {
            // Load existing user data
            var user = await Service.GetAsync(Id);
            Model.Username = user.Username;
            Model.Email = user.Email;
            Model.Phone = user.Phone;
            Model.Nickname = user.Nickname;
        }
    }

    private async Task OnSubmitAsync(EditContext context)
    {
        if (!context.Validate())
        {
            return;
        }

        var data = new UserUpdateDto
        {
            Email = Model.Email,
            Nickname = Model.Nickname,
            Phone = Model.Phone
        };

        await Service.UpdateAsync(Id, data);

        NavigationManager.NavigateTo("/users");
    }

    private class ViewModel
    {
        public string Username { get; set; }

        [StringLength(64, MinimumLength = 2, ErrorMessageResourceType = typeof(UserResources),
            ErrorMessageResourceName = nameof(UserResources.IDS_EDIT_ERROR_NICKNAME_LENGTH))]
        public string Nickname { get; set; }

        [Required(AllowEmptyStrings = false, ErrorMessageResourceType = typeof(UserResources),
          ErrorMessageResourceName = nameof(UserResources.IDS_EDIT_ERROR_EMAIL_REQUIRED))]
        [RegularExpression(RegexPattern.EmailAddress, ErrorMessageResourceType = typeof(UserResources),
         ErrorMessageResourceName = nameof(UserResources.IDS_EDIT_ERROR_EMAIL_FORMAT))]
        public string Email { get; set; }

        [RegularExpression(RegexPattern.PhoneNumber, ErrorMessageResourceType = typeof(UserResources),
            ErrorMessageResourceName = nameof(UserResources.IDS_EDIT_ERROR_PHONE_FORMAT))]
        public string Phone { get; set; }
    }

}