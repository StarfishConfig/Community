@using System.ComponentModel.DataAnnotations
@implements IDialogContentComponent<long>

@inject IConfigurationApplicationService Service
@inject IToastService ToastService

<FluentDialogHeader ShowDismiss="true">
    <FluentStack VerticalAlignment="VerticalAlignment.Center">
        <FluentIcon Value="@(new Icons.Regular.Size24.Apps())"/>
        <FluentLabel Typo="Typography.PaneHeader">
            @Dialog.Instance.Parameters.Title
        </FluentLabel>
    </FluentStack>
</FluentDialogHeader>

<FluentDialogBody>
    <FluentStack Orientation="Orientation.Vertical">
        <FluentEditForm @ref="_editForm" EditContext="_editContext" OnSubmit="@OnSubmitAsync" FormName="form"
                        Style="width: 100%">
            <DataAnnotationsValidator/>

            <FluentStack Orientation="Orientation.Vertical">
                <TeamSelector Label="@ConfigurationResources.IDS_PAGE_EDIT_LABEL_TEAM"
                              Role="@TeamMemberRole.Owner"
                              @bind-SelectedOption="@SelectedTeam"/>

                <FluentTextField @bind-Value="@Model.Code"
                                 Style="width: 100%"
                                 Label="@ConfigurationResources.IDS_PAGE_EDIT_LABEL_CODE"/>
                <FluentTextField @bind-Value="@Model.Name"
                                 Style="width: 100%"
                                 Label="@ConfigurationResources.IDS_PAGE_INDEX_COLUMN_NAME"/>
                <FluentTextArea @bind-Value="@Model.Description"
                                Style="width: 100%"
                                Label="@ConfigurationResources.IDS_PAGE_INDEX_COLUMN_DESCRIPTION"
                                Maxlength="1000"/>
            </FluentStack>

            <FluentValidationSummary/>
        </FluentEditForm>
    </FluentStack>
</FluentDialogBody>

<FluentDialogFooter>
    <FluentButton Appearance="Appearance.Accent" OnClick="@SaveAsync"
                  Loading="Loading">@(CommonResources.IDS_COMMON_SAVE)</FluentButton>
    <FluentButton Appearance="Appearance.Neutral"
                  OnClick="@(() => Dialog.CancelAsync())">@(CommonResources.IDS_COMMON_CANCEL)</FluentButton>
</FluentDialogFooter>

@code {

    [Parameter]
    public long Content { get; set; }

    [CascadingParameter]
    public FluentDialog Dialog { get; set; }

    private bool Loading { get; set; }

    private EditContext _editContext;
    private FluentEditForm _editForm;

    private ViewModel Model { get; } = new();

    private TeamListDto SelectedTeam
    {
        get;
        set
        {
            field = value;
            Model.TeamId = value?.Id ?? 0;
            _editContext.NotifyValidationStateChanged();
        }
    }

    /// <inheritdoc/>
    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(Model);
        await base.OnInitializedAsync();
    }

    private async Task SaveAsync(MouseEventArgs args)
    {
        await _editForm.OnSubmit.InvokeAsync(_editContext);
    }

    private async Task OnSubmitAsync(EditContext context)
    {
        try
        {
            if (!context.Validate())
            {
                return;
            }

            Loading = true;
            var data = new ConfigurationCreateDto
            {
                Code = Model.Code,
                Description = Model.Description,
                Name = Model.Name,
                TeamId = Model.TeamId
            };
            await Service.CreateAsync(data);

            await Dialog.CloseAsync();
        }
        catch (Exception exception)
        {
            ToastService.ShowError(exception.GetBaseException().Message);
        }
        finally
        {
            Loading = false;
        }
    }

    private class ViewModel
    {
        [Range(0, long.MaxValue, MinimumIsExclusive = true)]
        public long TeamId { get; set; }

        [Required]
        public string Code { get; set; }

        [Required]
        public string Name { get; set; }

        public string Description { get; set; }
    }

}