@page "/templates"
@using Nerosoft.Starfish.Shared

@inject ITemplateApplicationService Service
@inject IDialogService DialogService

<PageTitle>@SystemResources.IDS_TEMPLATE_INDEX_TITLE</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Style="width: 100%">
    <FluentBreadcrumb Style="margin-bottom: 16px;">
        <FluentBreadcrumbItem Href="/">@LayoutResources.IDS_MENU_TEXT_HOME</FluentBreadcrumbItem>
        <FluentBreadcrumbItem Href="/templates">@LayoutResources.IDS_MENU_TEXT_TEMPLATE</FluentBreadcrumbItem>
    </FluentBreadcrumb>

    <FluentLabel Typo="Typography.Header">@SystemResources.IDS_TEMPLATE_INDEX_TITLE</FluentLabel>

    <FluentAccordion Style="width: 100%">
        <FluentAccordionItem Heading="@CommonResources.IDS_LABEL_TEXT_FILTER" Expanded="true">
            <FluentIcon Value="@(new Icons.Regular.Size20.FilterAdd())" Color="@Color.Neutral" Slot="start"/>
            <FluentGrid Spacing="1" Justify="JustifyContent.FlexStart" Style="padding: 5px;">
                <FluentGridItem xs="12" sm="6" md="3">
                    <FluentTextField @bind-Value="Keyword" Label="@CommonResources.IDS_LABEL_TEXT_KEYWORD"
                                     Style="width: 100%"
                                     Placeholder="@CommonResources.IDS_PLACEHOLDER_KEYWORD"/>
                </FluentGridItem>
                <FluentGridItem xs="12" sm="6" md="3">
                    <FluentSelect TOption="Option<TemplateType>"
                                  Items="@MessageTemplateTypes"
                                  OptionValue="@(i => i.Value.ToString())"
                                  OptionText="@(i => i.Text)"
                                  Label="@SystemResources.IDS_TEMPLATE_LABEL_TYPE"
                                  Style="width: 100%"
                                  @bind-SelectedOption="@SelectedType"/>
                </FluentGridItem>
            </FluentGrid>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.End">
                <FluentAnchor IconStart="@(new Icons.Regular.Size16.Add())"
                              Appearance="Appearance.Lightweight"
                              Href="/templates/new">
                    @SystemResources.IDS_TEMPLATE_INDEX_BUTTON_TEXT_NEW
                </FluentAnchor>
                <FluentButton IconStart="@(new Icons.Regular.Size16.Broom())"
                              Disabled="@Loading"
                              OnClick="@OnClearClicked">
                    @CommonResources.IDS_BUTTON_TEXT_CLEAR_FILTER
                </FluentButton>
                <FluentButton IconStart="@(new Icons.Regular.Size16.Search())"
                              Appearance="Appearance.Accent"
                              Loading="@Loading"
                              OnClick="@OnSearchClicked">
                    @CommonResources.IDS_BUTTON_TEXT_SEARCH
                </FluentButton>
            </FluentStack>
        </FluentAccordionItem>
    </FluentAccordion>

    <FluentDataGrid @ref="_dataGrid"
                    Style="width: 100%"
                    TGridItem="TemplateListDto"
                    Items="_dataSource" 
                    RowSize="DataGridRowSize.Large"
                    GenerateHeader="GenerateHeaderOption.Sticky"
                    Loading="Loading"
                    Pagination="Pagination"
                    RefreshItems="@RefreshItemsAsync">
        <PropertyColumn Title="@SystemResources.IDS_TEMPLATE_LABEL_NAME" Property="p => p.Name"/>
        <PropertyColumn Title="@SystemResources.IDS_TEMPLATE_LABEL_CODE" Property="p => p.Code"/>
        <TemplateColumn Title="@SystemResources.IDS_TEMPLATE_LABEL_TYPE" Width="120px">
            <label>@GetTemplateTypeText(context.Type)</label>
        </TemplateColumn>
        <PropertyColumn Title="@SystemResources.IDS_TEMPLATE_LABEL_LANGUAGE" Property="p => p.Language"
                        Width="120px"/>
        <PropertyColumn Title="@SystemResources.IDS_TEMPLATE_LABEL_SUBJECT" Property="p => p.Subject"/>
        <TemplateColumn Title="@SystemResources.IDS_TEMPLATE_DEFAULT" Width="120px">
            @if (context.Default)
            {
                <FluentBadge Appearance="Appearance.Accent">@CommonResources.IDS_COMMON_YES</FluentBadge>
            }
            else
            {
                <FluentBadge Appearance="Appearance.Lightweight">@CommonResources.IDS_COMMON_NO</FluentBadge>
            }
        </TemplateColumn>
        <TemplateColumn Title="@SystemResources.IDS_TEMPLATE_LABEL_STATE" Width="120px">
            @if (context.Active)
            {
                <FluentButton Appearance="Appearance.Accent"
                              OnClick="@(() => DisableAsync(context.Id, context.Name))">@CommonResources.IDS_LABEL_TEXT_ACTIVE</FluentButton>
            }
            else
            {
                <FluentButton Appearance="Appearance.Lightweight"
                              OnClick="@(() => EnableAsync(context.Id, context.Name))">@CommonResources.IDS_LABEL_TEXT_INACTIVE</FluentButton>
            }
        </TemplateColumn>
        <TemplateColumn Title="@CommonResources.IDS_COMMON_COLUMN_ACTIONS" Align="@Align.Center">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Center">
                <FluentAnchor
                    Href="@($"/templates/{context.Id}/edit")">@CommonResources.IDS_BUTTON_TEXT_EDIT</FluentAnchor>
                <FluentButton OnClick="@(() => OnDeleteClicked(context.Id, context.Name))"
                              Style="color: orangered">@CommonResources.IDS_BUTTON_TEXT_DELETE</FluentButton>
            </FluentStack>
        </TemplateColumn>
    </FluentDataGrid>

    <FluentDataGridPaginator State="@Pagination"/>
</FluentStack>

@code {
    private FluentDataGrid<TemplateListDto> _dataGrid;
    private IQueryable<TemplateListDto> _dataSource = Enumerable.Empty<TemplateListDto>().AsQueryable();
    private PaginationState Pagination { get; } = new() { ItemsPerPage = 10 };

    private List<Option<TemplateType>> MessageTemplateTypes { get; } =
    [
        new() { Value = TemplateType.None, Text = SystemResources.IDS_TEMPLATE_TYPE_ALL, Selected = true },
        new() { Value = TemplateType.Sms, Text = SystemResources.IDS_TEMPLATE_TYPE_SMS },
        new() { Value = TemplateType.Email, Text = SystemResources.IDS_TEMPLATE_TYPE_EMAIL },
        new() { Value = TemplateType.Notification, Text = SystemResources.IDS_TEMPLATE_TYPE_NOTIFICATION }
    ];

    private Option<TemplateType> SelectedType { get; set; }

    private string Keyword { get; set; }

    private bool Loading { get; set; }

    private async Task RefreshItemsAsync(GridItemsProviderRequest<TemplateListDto> request)
    {
        Loading = true;

        await InvokeAsync(StateHasChanged);

        var result = await Service.SearchAsync(SelectedType?.Value ?? TemplateType.None, Keyword, 0, Pagination.ItemsPerPage);

        _dataSource = result.AsQueryable();

        Loading = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnClearClicked(MouseEventArgs args)
    {
        Keyword = string.Empty;
        await _dataGrid.RefreshDataAsync(true);
    }

    private async Task OnSearchClicked(MouseEventArgs args)
    {
        await _dataGrid.RefreshDataAsync(true);
    }

    private async Task OnDeleteClicked(long id, string name)
    {
        var message = string.Format(SystemResources.IDS_TEMPLATE_DELETE_COMFIRMATION, name);

        var dialog = await DialogService.ShowConfirmationAsync(message, CommonResources.IDS_COMMON_YES, CommonResources.IDS_COMMON_NO, CommonResources.IDS_DIALOG_TITLE_CONFIRM);

        var result = await dialog.Result;

        if (!result.Cancelled)
        {
            await Service.DeleteAsync(id);
            await _dataGrid.RefreshDataAsync(true);
        }
    }

    private async Task EnableAsync(long id, string name)
    {
        await _dataGrid.RefreshDataAsync();
    }

    private async Task DisableAsync(long id, string name)
    {
        await _dataGrid.RefreshDataAsync();
    }

    private static string GetTemplateTypeText(TemplateType type)
    {
        return SystemResources.ResourceManager.GetString($"IDS_TEMPLATE_TYPE_{type}".Normalize(TextCaseType.Upper)) ?? type.ToString();
    }

}
