@page "/templates/{Id:long}/edit"
@page "/templates/new"

@rendermode @(new InteractiveServerRenderMode(false))

@using Blazor.Monaco
@using Nerosoft.Starfish.Shared

@inject IDialogService DialogService
@inject ITemplateAppService Service
@inject NavigationManager NavigationManager
@if (Id > 0)
{
    <PageTitle>@SystemResources.IDS_TEMPLATE_UPDATE_TITLE</PageTitle>
}
else
{
    <PageTitle>@SystemResources.IDS_TEMPLATE_CREATE_TITLE</PageTitle>
}

<FluentStack VerticalGap="16" Orientation="Orientation.Vertical">
    @if (Id > 0)
    {
        <FluentLabel Typo="Typography.Header">@SystemResources.IDS_TEMPLATE_UPDATE_TITLE</FluentLabel>
    }
    else
    {
        <FluentLabel Typo="Typography.Header">@SystemResources.IDS_TEMPLATE_CREATE_TITLE</FluentLabel>
    }

    <FluentEditForm EditContext="_editContext" OnSubmit="@OnSubmitAsync" FormName="form" Style="width: 100%">
        <DataAnnotationsValidator />
        <FluentValidationSummary />

        <FluentBodyContent>
            <FluentGrid Columns="12" RowGap="10" ColumnGap="10">
                <FluentGridItem sm="12" md="6" lg="3">
                    <FluentSelect Label="@SystemResources.IDS_TEMPLATE_LABEL_TYPE"
                                  Style="width: 100%"
                                  TOption="Option<TemplateType>"
                                  Items="@TemplateTypes"
                                  OptionValue="@(i => i.Value.ToString())"
                                  OptionText="@(i => i.Text)"
                                  @bind-SelectedOption="@SelectedType" />
                </FluentGridItem>
                <FluentGridItem sm="12" md="6" lg="3">
                    <FluentTextField Label="@SystemResources.IDS_TEMPLATE_LABEL_NAME"
                                     Placeholder="@SystemResources.IDS_TEMPLATE_PLACEHOLDER_NAME"
                                     Style="width: 100%"
                                     @bind-Value="Model.Name" />
                </FluentGridItem>
                <FluentGridItem sm="12" md="6" lg="3">
                    <FluentTextField Label="@SystemResources.IDS_TEMPLATE_LABEL_CODE"
                                     Placeholder="@SystemResources.IDS_TEMPLATE_PLACEHOLDER_CODE"
                                     Style="width: 100%"
                                     @bind-Value="@Model.Code" />
                </FluentGridItem>
                <FluentGridItem sm="12" md="6" lg="3">
                    <FluentTextField Label="@SystemResources.IDS_TEMPLATE_LABEL_LANGUAGE"
                                     Placeholder="@SystemResources.IDS_TEMPLATE_PLACEHOLDER_LANGUAGE"
                                     Style="width: 100%"
                                     @bind-Value="@Model.Language" />
                </FluentGridItem>
                <FluentGridItem md="12">
                    <FluentTextField Label="@SystemResources.IDS_TEMPLATE_LABEL_SUBJECT"
                                     Placeholder="@SystemResources.IDS_TEMPLATE_PLACEHOLDER_SUBJECT"
                                     Style="width: 100%"
                                     @bind-Value="Model.Subject" />
                </FluentGridItem>
                <FluentGridItem md="12">
                    <MonacoEditor @ref="_editor" Language="Language.Html"
                                  EditorOptions="@EditorOptions" ScriptContent="{{}}" />
                </FluentGridItem>
            </FluentGrid>
            <div style="width: 100%; display: flex; align-items: center;column-gap: 16px; margin-top: 16px;">
                <FluentButton Style="width: 100px;" Appearance="Appearance.Accent" Type="ButtonType.Submit">
                    @CommonResources.IDS_BUTTON_TEXT_SUBMIT
                </FluentButton>

                <FluentCheckbox Label="@SystemResources.IDS_TEMPLATE_EDIT_SET_DEFAULT" @bind-Value="Model.Default" />
            </div>
        </FluentBodyContent>
    </FluentEditForm>
</FluentStack>
@code {

    [Parameter]
    public long? Id { get; set; }

    private MonacoEditor _editor;

    private EditorOptions EditorOptions { get; } = new()
    {
        Minimap = new MinimapOptions
        {
            Enabled = false
        },
        AutoClosingBrackets = AutoClosingBrackets.Always,
        Theme = Theme.VsDark
    };

    private List<Option<TemplateType>> TemplateTypes { get; } =
    [
        new() { Value = TemplateType.None, Text = SystemResources.IDS_TEMPLATE_TYPE_NONE },
        new() { Value = TemplateType.Sms, Text = SystemResources.IDS_TEMPLATE_TYPE_SMS },
        new() { Value = TemplateType.Email, Text = SystemResources.IDS_TEMPLATE_TYPE_EMAIL },
        new() { Value = TemplateType.Notification, Text = SystemResources.IDS_TEMPLATE_TYPE_NOTIFICATION }
    ];

    private Option<TemplateType> SelectedType
    {
        get
        {
            return Model == null ? TemplateTypes[0] : TemplateTypes.FirstOrDefault(t => t.Value == Model.Type);
        }
        set
        {
            if (value != null)
            {
                Model.Type = value.Value;
            }
        }
    }

    private EditContext _editContext;

    private TemplateEditDto Model { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(Model);
        await LoadAsync();
    }

    private async Task OnSubmitAsync(EditContext context)
    {
        var content = await _editor.GetEditorContent();
        Model.Body = content;
        if (Id > 0)
        {
            await Service.UpdateAsync(Id.Value, Model);
        }
        else
        {
            await Service.CreateAsync(Model);
        }
        NavigationManager.NavigateTo("/templates");
    }

    private async Task OpenEditorAsync()
    {
        var options = new StandaloneEditor.StandaloneEditorOptions
        {
            Language = Language.Html
            // Properties = new Dictionary<string, object>
            // {
            //     { "value", Model.Content ?? string.Empty }
            // }
        };

        var parameters = new DialogParameters
        {
            { "Content", options }
        };

        var dialog = await DialogService.ShowDialogAsync<StandaloneEditor>(options, new DialogParameters { Title = "", Width = "calc(100% - 2px)", Height = "calc(100% - 2px)", PreventDismissOnOverlayClick = true });

        var result = await dialog.Result;

        // if (!result.Cancelled)
        // {
        //     if (result.Data is Dictionary<string, object> data && data.ContainsKey("value"))
        //     {
        //         Model.Content = data["value"]?.ToString();
        //     }
        // }
    }

    private async Task LoadAsync()
    {
        if (Id.HasValue)
        {
            var detail = await Service.GetAsync(Id.Value);
            if (detail != null)
            {
                Model.Name = detail.Name;
                Model.Code = detail.Code;
                Model.Language = detail.Language;
                Model.Subject = detail.Subject;
                Model.Type = detail.Type;
                Model.Body = detail.Body;
                Model.Default = detail.Default;
                await _editor.SetEditorContent(Model.Body);
            }

            SelectedType = TemplateTypes.FirstOrDefault(t => t.Value == Model.Type);
        }
    }

}