@inject ITeamApplicationService Service
@inject IDialogService DialogService
@inject IToastService ToastService

<FluentGrid Spacing="1" Justify="JustifyContent.FlexStart" Style="padding: 5px;">
    <FluentGridItem xs="12" sm="6" md="3">
        <FluentTextField @bind-Value="Keyword"
                         Style="width: 100%"
                         Placeholder="@CommonResources.IDS_PLACEHOLDER_KEYWORD" />
    </FluentGridItem>
    <FluentGridItem xs="12" sm="6" md="9">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.End">
            <FluentButton IconStart="@(new Icons.Regular.Size16.Broom())"
                          Disabled="@Loading"
                          OnClick="@OnClearClicked">
                @CommonResources.IDS_BUTTON_TEXT_CLEAR_FILTER
            </FluentButton>
            <FluentButton IconStart="@(new Icons.Regular.Size16.Search())"
                          Appearance="Appearance.Accent"
                          Loading="@Loading"
                          OnClick="@OnSearchClicked">
                @CommonResources.IDS_BUTTON_TEXT_SEARCH
            </FluentButton>
        </FluentStack>
    </FluentGridItem>
</FluentGrid>

<FluentDataGrid @ref="_dataGrid" Style="width: 100%"
                TGridItem="TeamMemberDto"
                Items="_dataSource"
                RowSize="DataGridRowSize.Large"
                GenerateHeader="GenerateHeaderOption.Sticky"
                Loading="Loading"
                Pagination="Pagination"
                RefreshItems="@RefreshItemsAsync">
    <PropertyColumn Title="@TeamResources.IDS_DETAIL_COLUMN_USERNAME"
                    Property="@(p => p.Username)" />
    <PropertyColumn Title="@TeamResources.IDS_DETAIL_COLUMN_NICKNAME"
                    Property="@(p => p.Nickname)" />
    <PropertyColumn Title="@TeamResources.IDS_DETAIL_COLUMN_EMAIL"
                    Property="@(p => p.Email)" />
    <PropertyColumn Title="@TeamResources.IDS_DETAIL_COLUMN_PHONE"
                    Property="@(p => p.Phone)" />
    <PropertyColumn Title="@TeamResources.IDS_DETAIL_COLUMN_JOINED_TIME"
                    Property="@(p => p.JoinedAt)" />
    <TemplateColumn Title="@CommonResources.IDS_COMMON_COLUMN_ACTIONS" Align="@Align.Center">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Center">
            <FluentButton OnClick="@(() => OnRemoveClicked(context.UserId, context.Username))"
                          IconStart="@(new Icons.Regular.Size16.PersonDelete())"
                          Disabled="@(!IsOwner)"
                          Appearance="Appearance.Accent">@TeamResources.IDS_DETAIL_BUTTON_TEXT_REMOVE_MEMBER</FluentButton>
        </FluentStack>
    </TemplateColumn>
</FluentDataGrid>

<FluentDataGridPaginator State="@Pagination" />

@code {
    [Parameter]
    public long Id { get; set; }

    [Parameter]
    public bool IsOwner { get; set; }

    [Parameter]
    public string OwnerId { get; set; }

    private string Keyword { get; set; } = string.Empty;

    private bool Loading { get; set; } = false;

    private FluentDataGrid<TeamMemberDto> _dataGrid;
    private IQueryable<TeamMemberDto> _dataSource = Enumerable.Empty<TeamMemberDto>().AsQueryable();
    private PaginationState Pagination { get; } = new() { ItemsPerPage = 10 };

    public async Task RefreshDataAsync(int? page = null)
    {
        if (page >= 0)
        {
            await Pagination.SetCurrentPageIndexAsync(0);
        }
        else
        {
            await _dataGrid.RefreshDataAsync(true);
        }
    }

    private async Task OnSearchClicked(MouseEventArgs args)
    {
        await Pagination.SetCurrentPageIndexAsync(0);
    }

    private async Task OnClearClicked(MouseEventArgs args)
    {
        Keyword = string.Empty;
        await Pagination.SetCurrentPageIndexAsync(0);
    }

    private async Task RefreshItemsAsync(GridItemsProviderRequest<TeamMemberDto> request)
    {
        Loading = true;

        await InvokeAsync(StateHasChanged);

        var result = await Service.GetMemberListAsync(Id, Keyword, Pagination.CurrentPageIndex * Pagination.ItemsPerPage, Pagination.ItemsPerPage);

        _dataSource = result.AsQueryable();

        Loading = false;

        if (Pagination.CurrentPageIndex == 0)
        {
            var count = await Service.GetMemberCountAsync(Id, Keyword);
            await Pagination.SetTotalItemCountAsync(count);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnRemoveClicked(string userId, string name)
    {
        try
        {
            if (string.Equals(userId, OwnerId))
            {
                throw new InvalidOperationException(TeamResources.IDS_DETAIL_ERROR_CANNOT_REMOVE_OWNER);
            }

            var message = string.Format(TeamResources.IDS_DETAIL_MESSAGE_REMOVE_MEMBER_CONFIRM, name);
            var dialog = await DialogService.ShowConfirmationAsync(message, CommonResources.IDS_COMMON_YES, CommonResources.IDS_COMMON_NO, CommonResources.IDS_DIALOG_TITLE_CONFIRM);
            var result = await dialog.Result;
            if (!result.Cancelled)
            {
                await Service.RemoveMemberAsync(Id, [userId]);
                await _dataGrid.RefreshDataAsync(true);
            }
        }
        catch (Exception exception)
        {
            ToastService.ShowError(exception.Message);
        }
    }
}
