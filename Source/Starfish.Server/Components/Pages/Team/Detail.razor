@page "/teams/{Id:long}"

@inject ITeamApplicationService Service
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject IToastService ToastService

<PageTitle>@TeamResources.IDS_DETAIL_TITLE</PageTitle>

<FluentStack VerticalGap="16" Orientation="Orientation.Vertical" Style="width: 100%">
    <FluentBreadcrumb Style="margin-bottom: 16px;">
        <FluentBreadcrumbItem Href="/">@LayoutResources.IDS_MENU_TEXT_HOME</FluentBreadcrumbItem>
        <FluentBreadcrumbItem Href="/teams">@LayoutResources.IDS_MENU_TEXT_TEAM_MANAGEMENT</FluentBreadcrumbItem>
        <FluentBreadcrumbItem Href="@($"/teams/{Id}")">@TeamResources.IDS_DETAIL_TITLE</FluentBreadcrumbItem>
    </FluentBreadcrumb>

    <FluentLabel Typo="Typography.Header">@TeamResources.IDS_DETAIL_TITLE</FluentLabel>

    <FluentAccordion Style="width: 100%">
        <FluentAccordionItem Heading="@TeamResources.IDS_DETAIL_PANEL_HEADER" Expanded="true">
            <FluentIcon Value="@(new Icons.Regular.Size20.Info())" Color="@Color.Neutral" Slot="start"/>
            <FluentGrid Spacing="1" Justify="JustifyContent.FlexStart" Style="padding: 5px;">
                <FluentGridItem md="12">
                    <FluentTextField Value="@Data?.Name" Label="@TeamResources.IDS_DETAIL_LABEL_NAME"
                                     Style="width: 100%" Disabled="true"
                                     Class="input-disabled"/>
                </FluentGridItem>
                <FluentGridItem md="12">
                    <FluentTextArea Value="@Data?.Description" Label="@TeamResources.IDS_EDIT_LABEL_DESCRIPTION"
                                    Style="width: 100%;" Disabled="true"
                                    Class="input-disabled"/>
                </FluentGridItem>
                @if (IsOwner)
                {
                    <FluentGridItem md="12">
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.End">

                            <FluentButton IconStart="@(new Icons.Regular.Size16.Add())"
                                          Appearance="Appearance.Lightweight"
                                          OnClick="@OnAppendClicked">
                                @TeamResources.IDS_DETAIL_BUTTON_TEXT_APPEND_MEMBER
                            </FluentButton>
                            <FluentButton IconStart="@(new Icons.Regular.Size16.Delete())"
                                          Appearance="Appearance.Stealth"
                                          Loading="@Loading"
                                          OnClick="@OnSearchClicked">
                                @CommonResources.IDS_BUTTON_TEXT_DELETE
                            </FluentButton>
                        </FluentStack>
                    </FluentGridItem>
                }
            </FluentGrid>

        </FluentAccordionItem>
    </FluentAccordion>

    <FluentAccordion Style="width: 100%">
        <FluentAccordionItem Heading="@CommonResources.IDS_LABEL_TEXT_FILTER" Expanded="true">
            <FluentIcon Value="@(new Icons.Regular.Size20.Info())" Color="@Color.Neutral" Slot="start"/>
            <FluentGrid Spacing="1" Justify="JustifyContent.FlexStart" Style="padding: 5px;">
                <FluentGridItem sm="12" md="6">
                    <FluentTextField @bind-Value="Keyword"
                                     Style="width: 100%"
                                     Placeholder="@CommonResources.IDS_PLACEHOLDER_KEYWORD"/>
                </FluentGridItem>
                <FluentGridItem sm="12" md="6">
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.End">
                        <FluentButton IconStart="@(new Icons.Regular.Size16.Broom())"
                                      Disabled="@Loading"
                                      OnClick="@OnClearClicked">
                            @CommonResources.IDS_BUTTON_TEXT_CLEAR_FILTER
                        </FluentButton>
                        <FluentButton IconStart="@(new Icons.Regular.Size16.Search())"
                                      Appearance="Appearance.Accent"
                                      Loading="@Loading"
                                      OnClick="@OnSearchClicked">
                            @CommonResources.IDS_BUTTON_TEXT_SEARCH
                        </FluentButton>
                    </FluentStack>
                </FluentGridItem>
            </FluentGrid>

        </FluentAccordionItem>
    </FluentAccordion>

    <FluentDataGrid @ref="_dataGrid" Style="width: 100%"
                    TGridItem="TeamMemberDto"
                    Items="_dataSource"
                    RowSize="DataGridRowSize.Large"
                    GenerateHeader="GenerateHeaderOption.Sticky"
                    Loading="Loading"
                    Pagination="Pagination"
                    RefreshItems="@RefreshItemsAsync">
        <PropertyColumn Title="@TeamResources.IDS_DETAIL_COLUMN_USERNAME"
                        Property="@(p => p.Username)"/>
        <PropertyColumn Title="@TeamResources.IDS_DETAIL_COLUMN_NICKNAME"
                        Property="@(p => p.Nickname)"/>
        <PropertyColumn Title="@TeamResources.IDS_DETAIL_COLUMN_EMAIL"
                        Property="@(p => p.Email)"/>
        <PropertyColumn Title="@TeamResources.IDS_DETAIL_COLUMN_PHONE"
                        Property="@(p => p.Phone)"/>
        <PropertyColumn Title="@TeamResources.IDS_DETAIL_COLUMN_JOINED_TIME"
                        Property="@(p => p.JoinedAt)"/>
        <TemplateColumn Title="@CommonResources.IDS_COMMON_COLUMN_ACTIONS" Align="@Align.Center">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Center">
                <FluentButton OnClick="@(() => OnRemoveClicked(context.UserId, context.Username))"
                              IconStart="@(new Icons.Regular.Size16.PersonDelete())"
                              Disabled="@(!IsOwner)"
                              Appearance="Appearance.Accent">@TeamResources.IDS_DETAIL_BUTTON_TEXT_REMOVE_MEMBER</FluentButton>
            </FluentStack>
        </TemplateColumn>
    </FluentDataGrid>

    <FluentDataGridPaginator State="@Pagination"/>
</FluentStack>

@code {

    [CascadingParameter]
    private UserPrincipal Identity { get; set; }

    [Parameter]
    public long Id { get; set; }

    private TeamDetailDto Data { get; set; }
    
    private bool IsOwner => string.Equals(Identity.UserId, Data?.OwnerId);

    private bool Loading { get; set; }

    private string Keyword { get; set; } = string.Empty;

    private FluentDataGrid<TeamMemberDto> _dataGrid;
    private IQueryable<TeamMemberDto> _dataSource = Enumerable.Empty<TeamMemberDto>().AsQueryable();
    private PaginationState Pagination { get; } = new() { ItemsPerPage = 10 };

    protected override async Task OnInitializedAsync()
    {
        var detail = await Service.GetAsync(Id);
        if (detail == null)
        {
            Navigation.NavigateTo("not-found");
        }
        else
        {
            Data = detail;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnSearchClicked(MouseEventArgs args)
    {
        await _dataGrid.RefreshDataAsync(true);
    }

    private async Task OnClearClicked(MouseEventArgs args)
    {
        Keyword = string.Empty;
        await _dataGrid.RefreshDataAsync(true);
    }

    private async Task OnAppendClicked(MouseEventArgs args)
    {
        DialogParameters parameters = new()
        {
            Title = TeamResources.IDS_APPEND_TITLE,
            Width = "800px",
            Modal = false,
            ShowDismiss = false,
            PreventDismissOnOverlayClick = true
        };

        var dialog = await DialogService.ShowDialogAsync<Append>(Id, parameters);

        var result = await dialog.Result;
        if (!result.Cancelled)
        {
            await Pagination.SetCurrentPageIndexAsync(0);
        }
    }

    private async Task OnRemoveClicked(string userId, string name)
    {
        try
        {
            if (string.Equals(userId, Data.OwnerId))
            {
                throw new InvalidOperationException(TeamResources.IDS_DETAIL_ERROR_CANNOT_REMOVE_OWNER);
            }

            var message = string.Format(TeamResources.IDS_DETAIL_MESSAGE_REMOVE_MEMBER_CONFIRM, name);
            var dialog = await DialogService.ShowConfirmationAsync(message, CommonResources.IDS_COMMON_YES, CommonResources.IDS_COMMON_NO, CommonResources.IDS_DIALOG_TITLE_CONFIRM);
            var result = await dialog.Result;
            if (!result.Cancelled)
            {
                await Service.RemoveMemberAsync(Id, [userId]);
                await _dataGrid.RefreshDataAsync(true);
            }
        }
        catch (Exception exception)
        {
            ToastService.ShowError(exception.Message);
        }
    }

    private async Task RefreshItemsAsync(GridItemsProviderRequest<TeamMemberDto> request)
    {
        Loading = true;

        await InvokeAsync(StateHasChanged);

        var result = await Service.GetMemberListAsync(Id, Keyword, 0, Pagination.ItemsPerPage);

        _dataSource = result.AsQueryable();

        Loading = false;

        await InvokeAsync(StateHasChanged);
    }

}