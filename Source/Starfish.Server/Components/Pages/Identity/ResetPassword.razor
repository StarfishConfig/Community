@page "/identity/password/reset"
@using System.ComponentModel.DataAnnotations
@using ValidationException = System.ValidationException
@layout EmptyLayout
@rendermode InteractiveServer

@inject IUserApplicationService Service
@inject NavigationManager Navigation

<PageTitle>@IdentityResources.IDS_RESET_PASSWORD_TITLE</PageTitle>

<div class="main" style="width: 468px; margin: 50px auto auto;">
    <FluentStack Orientation="Orientation.Vertical">
        <div style="text-align:center;margin:32px auto;box-shadow:none;line-height: 36px;">
            <div class="header" style="display: flex; align-items: center;gap: 10px;">
                <img alt="logo" class="logo" src="logo.svg">
                <span class="title" style="color:#fcab66; font-size: 24px;">Starfish</span>
            </div>
            <div class="desc">@(CommonResources.IDS_COMMON_SUBTITLE)</div>
        </div>
        <FluentCard>
            <FluentEditForm FormName="form" EditContext="_editContext" OnSubmit="@OnSubmitAsync">
                <DataAnnotationsValidator/>
                <FluentValidationSummary/>
                <FluentGrid Columns="12" RowGap="10" ColumnGap="10">
                    <FluentGridItem md="12">
                        <div>
                            <FluentTextField Name="Model.Username" @bind-Value="Model.Username"
                                             AutoComplete="off" Required="true"
                                             Placeholder="Username/Email/Phone"
                                             Style="width: 100%">
                                <FluentIcon Value="@(new Icons.Regular.Size24.Person())" Slot="start"
                                            Color="Color.Neutral"/>
                            </FluentTextField>
                            <FluentValidationMessage For="@(() => Model.Username)"/>
                        </div>
                    </FluentGridItem>
                    <FluentGridItem md="9">
                        <FluentTextField Name="Model.Token" @bind-Value="Model.Token"
                                         AutoComplete="off" Required="true"
                                         Placeholder="验证码" Maxlength="6" Minlength="6"
                                         InputMode="InputMode.Numeric"
                                         Style="width: 100%">
                            <FluentIcon Value="@(new Icons.Regular.Size24.PhoneKey())" Slot="start"
                                        Color="Color.Neutral"/>
                        </FluentTextField>
                    </FluentGridItem>
                    <FluentGridItem md="3">
                        <CountDownButton DefaultText="发送验证码"
                                         CountingText="{0}秒后再试"
                                         CountdownSeconds="60" Action="@OnSendOtpAsync"/>
                    </FluentGridItem>
                    <FluentGridItem md="12">
                        <FluentTextField Name="Model.Password" @bind-Value="Model.Password"
                                         AutoComplete="off" Required="true" Placeholder="Password to login"
                                         Style="width: 100%"
                                         TextFieldType="TextFieldType.Password">
                            <FluentIcon Value="@(new Icons.Regular.Size24.ShieldKeyhole())" Slot="start"
                                        Color="Color.Neutral"/>
                        </FluentTextField>
                    </FluentGridItem>
                    <FluentGridItem md="12">
                        <div style="width: 100%; display: flex;align-items: center;">
                            <FluentButton Style="width: 100px;" Loading="Loading" Appearance="Appearance.Accent"
                                          Type="ButtonType.Submit">@IdentityResources.IDS_LOGIN_PAGE_BUTTON_TEXT_LOGIN</FluentButton>
                            <FluentSpacer/>
                            <a href="/identity/password/reset">@IdentityResources.IDS_LOGIN_PAGE_LINK_TEXT_FORGOT_PASSWORD</a>
                        </div>
                    </FluentGridItem>
                </FluentGrid>
            </FluentEditForm>
        </FluentCard>
    </FluentStack>
</div>

@code {

    [CascadingParameter]
    private HttpContext HttpContext { get; set; }

    [SupplyParameterFromForm]
    private ResetPasswordModel Model { get; set; }

    private bool Loading { get; set; } = false;
    private EditContext _editContext;

    protected override async Task OnInitializedAsync()
    {
        Model ??= new ResetPasswordModel();
        _editContext = new EditContext(Model);
        await base.OnInitializedAsync();
    }

    private async Task OnSubmitAsync(EditContext context)
    {
        var dto = new UserPasswordResetDto
        {
            Username = Model.Username,
            Password = Model.Password,
            Token = Model.Token
        };

        await Service.ResetPasswordAsync(dto);
        Navigation.NavigateTo("/identity/login");
    }

    private async Task<bool> OnSendOtpAsync()
    {
        try
        {
            if (string.IsNullOrEmpty(Model.Username))
            {
                throw new ValidationException("Username is required to send OTP.");
            }

            return true;
        }
        catch (Exception ex)
        {
            return false;
        }
    }

    private class ResetPasswordModel
    {
        [Required(ErrorMessageResourceName = "IDS_LOGIN_PAGE_BUTTON_TEXT_LOGIN", ErrorMessageResourceType = typeof(IdentityResources))]
        public string Username { get; set; }

        public string Password { get; set; }

        public string Token { get; set; }
    }

}