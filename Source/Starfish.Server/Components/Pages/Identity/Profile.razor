@page "/profile"
@using Nerosoft.Starfish.Facade.Transit

@inject IUserApplicationService Service

<PageTitle>@ProfileResources.IDS_TITLE</PageTitle>
<h3>@Data?.Username</h3>

@code {
    private UserProfileDto Data { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Data = await Service.GetProfileAsync();
        StateHasChanged();
    }
}