@page "/settings/message/template"
@using Nerosoft.Starfish.Shared
@rendermode InteractiveServer

@inject ITemplateAppService Service

<FluentAccordion>
    <FluentAccordionItem Heading="Filter(s)" Expanded="true">
        <FluentIcon Value="@(new Icons.Regular.Size20.FilterAdd())" Color="@Color.Neutral" Slot="start"/>
        <FluentGrid Spacing="1" Justify="JustifyContent.FlexStart" Style="padding: 5px;">
            <FluentGridItem xs="12" sm="6" md="3">
                <FluentTextField @bind-Value="Keyword" Label="关键字"
                                 Style="width: 100%"/>
            </FluentGridItem>
            <FluentGridItem xs="12" sm="6" md="3">
                <FluentSelect TOption="Option<TemplateType>"
                              Items="@MessageTemplateTypes"
                              OptionValue="@(i => i.Value.ToString())"
                              OptionText="@(i => i.Text)"
                              Label="模板类型"
                              @bind-SelectedOption="@SelectedType"/>
            </FluentGridItem>
        </FluentGrid>
        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.End">
            <FluentAnchor IconStart="@(new Icons.Regular.Size16.Add())"
                          Appearance="Appearance.Lightweight"
                          Href="/settings/message/template/edit">
                新建模板
            </FluentAnchor>
            <FluentButton IconStart="@(new Icons.Regular.Size16.Broom())"
                          Disabled="@Loading"
                          OnClick="@OnClearClicked">
                清除条件
            </FluentButton>
            <FluentButton IconStart="@(new Icons.Regular.Size16.Search())"
                          Appearance="Appearance.Accent"
                          Loading="@Loading"
                          OnClick="@OnSearchClicked">
                搜索
            </FluentButton>
        </FluentStack>
    </FluentAccordionItem>
</FluentAccordion>

