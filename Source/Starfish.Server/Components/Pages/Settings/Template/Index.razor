<FluentDataGrid @ref="_dataGrid"
                TGridItem="TemplateListDto"
                Items="_dataSource"
                GenerateHeader="GenerateHeaderOption.Sticky"
                Loading="Loading"
                Pagination="Pagination"
                RefreshItems="@RefreshItemsAsync">
    <PropertyColumn Title="Name" Property="p => p.Name"/>
    <PropertyColumn Title="Code" Property="p => p.Code"/>
    <TemplateColumn Title="Type" Width="100px">
        <label>@context.Type.ToString()</label>
    </TemplateColumn>
    <PropertyColumn Title="Language" Property="p=>p.Language"
                    Width="100px"/>
    <PropertyColumn Title="Subject" Property="p=>p.Subject"/>
    <PropertyColumn Title="Default" Property="p => p.Default"
                    Width="100px"/>
</FluentDataGrid>

<FluentPaginator State="@Pagination"/>

@code {
    private FluentDataGrid<TemplateListDto> _dataGrid;
    private IQueryable<TemplateListDto> _dataSource = Enumerable.Empty<TemplateListDto>().AsQueryable();
    private PaginationState Pagination { get; } = new() { ItemsPerPage = 10 };

    private List<Option<TemplateType>> MessageTemplateTypes { get; } =
    [
        new() { Value = TemplateType.None, Text = "All", Selected = true },
        new() { Value = TemplateType.Sms, Text = "Sms" },
        new() { Value = TemplateType.Email, Text = "Email" },
        new() { Value = TemplateType.Notification, Text = "Notification" }
    ];

    private Option<TemplateType> SelectedType { get; set; }

    private string Keyword { get; set; }

    private bool Loading { get; set; }

    private async Task RefreshItemsAsync(GridItemsProviderRequest<TemplateListDto> request)
    {
        Loading = true;

        await InvokeAsync(StateHasChanged);

        var result = await Service.SearchAsync(SelectedType.Value, Keyword, 0, Pagination.ItemsPerPage);

        _dataSource = result.AsQueryable();

        Loading = false;

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnClearClicked(MouseEventArgs args)
    {
        Keyword = string.Empty;
        await _dataGrid.RefreshDataAsync(true);
    }

    private async Task OnSearchClicked(MouseEventArgs args)
    {
        await _dataGrid.RefreshDataAsync(true);
    }

}