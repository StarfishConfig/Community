<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <ResourcePreloader @rendermode="@GetGlobalRenderMode()"/>
    <link rel="stylesheet" href="@Assets["_content/Microsoft.FluentUI.AspNetCore.Components/css/reboot.css"]"/>
    <link rel="stylesheet" href="@Assets["app.css"]"/>
    <link rel="stylesheet" href="@Assets["Starfish.Server.styles.css"]"/>
    <ImportMap/>
    <link rel="icon" type="image/png" href="favicon.png"/>
    <HeadOutlet @rendermode="@GetGlobalRenderMode()"/>
    <title></title>
</head>

<body>
<Routes @rendermode="@GetGlobalRenderMode()"/>
<ReconnectModal/>
<script src="@Assets["_framework/blazor.web.js"]"></script>
<script
    src="@Assets["_content/Microsoft.FluentUI.AspNetCore.Components/Microsoft.FluentUI.AspNetCore.Components.lib.module.js"]"
    type="module" async></script>
</body>

</html>

@code {

    [CascadingParameter]
    private HttpContext HttpContext { get; set; }

    private static readonly string[] _staticServerRenderRoutes =
    [
        "/login",
        "/logout",
        "/app",
        "/about",
        "/terms"
    ];

    private IComponentRenderMode GetGlobalRenderMode()
    {
        var path = HttpContext.Request.Path;

        var ssr = _staticServerRenderRoutes.Any(route => path.StartsWithSegments(route));

        return ssr ? null : new InteractiveServerRenderMode(false);
    }

}
